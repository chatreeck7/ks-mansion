---
// Separate from BaseLayout.astro on purpose: the console shares the brand
// but not the grid, and the marketing layout carries a language switcher
// and Google Sans that do not belong here.
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-console-paper font-console text-console-ink antialiased">
    <slot />
  </body>

  <style is:global>
    /**
     * The console prints on A4, because that is the paper in the building.
     *
     * Declared rather than left to the browser: with no `@page` size a print
     * falls back to the printing machine's locale default, which is Letter on
     * a good deal of hardware — 216 × 279mm against A4's 210 × 297. A bill
     * laid out for one and printed on the other is either cropped down the
     * right edge or floating in the middle of the sheet, and the tenant is
     * holding the result. Verified: before this rule, Chromium produced a
     * 612 × 792pt (Letter) page for /console/bills/<id>.
     *
     * The margin is here too, so the printed edge does not depend on a
     * setting in someone's print dialog. 10mm is inside the unprintable
     * border of every desktop printer and leaves the collection sheet's
     * sixteen day columns room to stay on one page.
     */
    @page {
      size: A4;
      margin: 10mm;
    }
  </style>
</html>
