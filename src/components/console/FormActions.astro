---
// src/components/console/FormActions.astro
import Button from './Button.astro';
interface Props {
  submitLabel: string;
  cancelHref: string;
  cancelLabel?: string;
}

const { submitLabel, cancelHref, cancelLabel = 'ยกเลิก' } = Astro.props;
---

<div class="mt-2 flex flex-wrap items-center gap-3 sm:col-span-2">
  <Button type="submit" size="lg">{submitLabel}</Button>

  <!-- A link, not a reset: cancelling means leaving, not blanking the form
       and sitting on it. -->
  <Button href={cancelHref} variant="secondary" size="lg">{cancelLabel}</Button>
</div>
