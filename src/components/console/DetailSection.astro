---
// src/components/console/DetailSection.astro
interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<section class="border-b border-console-rule px-4 py-4 last:border-b-0 desk:px-5">
  <h2 class="mb-2 font-hand text-[17px] font-semibold tracking-normal text-console-ink">{heading}</h2>
  <slot />
</section>
