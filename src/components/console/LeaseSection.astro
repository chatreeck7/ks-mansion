---
// src/components/console/LeaseSection.astro
// Shared by the room and tenant detail screens: the same lease facts, with
// the counterpart column swapped depending on which side you arrived from.
import DetailSection from './DetailSection.astro';
import { activeLeaseFor, endReasonLabel, leaseTermLabel, type Lease } from '@/lib/models/lease';
import { formatBaht } from '@/lib/format/thai';
import { consolePath } from '@/lib/console/paths';

interface Props {
  leases: Lease[];
  /** What the counterpart column shows — a room label, or a tenant name. */
  counterpartLabel: string;
  counterpartFor: (lease: Lease) => string;
  emptyMessage: string;
  now?: Date;
  /**
   * Where "add a lease" goes, prefilled for whichever side this is. Omitted
   * on a screen that has no sensible thing to prefill, which renders no
   * button rather than one that lands on an empty form.
   */
  addHref?: string;
}

const {
  leases,
  counterpartLabel,
  counterpartFor,
  emptyMessage,
  now = new Date(),
  addHref,
} = Astro.props;

const active = activeLeaseFor(leases, now);
// Most recent first: the current tenancy is what someone opened this for.
const history = [...leases].sort((a, b) => b.startDate.getTime() - a.startDate.getTime());
---

<DetailSection heading="สัญญาเช่า">
  {
    addHref && (
      <p class="mb-3">
        <a
          href={addHref}
          class="rounded border border-console-sunk px-3 py-1.5 text-sm text-console-ink hover:bg-console-sunk focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
        >
          เพิ่มสัญญาเช่า
        </a>
      </p>
    )
  }

  {
    history.length === 0 ? (
      <p class="mb-0 text-sm text-console-ink-faint">{emptyMessage}</p>
    ) : (
      <ul class="m-0 list-none space-y-3 p-0">
        {history.map((lease) => (
          <li class="border-l-2 pl-3" class:list={[lease.id === active?.id ? 'border-accent' : 'border-console-sunk']}>
            <p class="mb-1 flex flex-wrap items-baseline gap-x-2 text-sm">
              <span class="font-medium text-console-ink">{counterpartFor(lease)}</span>
              <span class="text-console-ink-faint">{counterpartLabel}</span>
              {lease.id === active?.id && (
                <span class="rounded bg-console-ok-bg px-1.5 py-0.5 text-xs text-console-ok">
                  ปัจจุบัน
                </span>
              )}
              {lease.endReason === 'absconded' && (
                <span class="rounded bg-console-crit-bg px-1.5 py-0.5 text-xs text-console-crit">
                  {endReasonLabel(lease.endReason)}
                </span>
              )}
            </p>
            <dl class="m-0 grid grid-cols-[auto_1fr] gap-x-4 gap-y-0.5 text-sm">
              <dt class="text-console-ink-faint">ระยะสัญญา</dt>
              <dd class="m-0">{leaseTermLabel(lease)}</dd>
              <dt class="text-console-ink-faint">ค่าเช่า</dt>
              <dd class="m-0 font-figure">{formatBaht(lease.rentRate)} ต่อเดือน</dd>
              <dt class="text-console-ink-faint">เงินประกัน</dt>
              <dd class="m-0 font-figure">{formatBaht(lease.deposit)}</dd>
              <dt class="text-console-ink-faint">ค่าเช่าล่วงหน้า</dt>
              <dd class="m-0 font-figure">{formatBaht(lease.advanceRent)}</dd>
              {/*
                Headcount only, not the water charge it implies. ค่าน้ำ is
                occupants × 100 for a home but metered for ร้านซักผ้า, and
                nothing in the model marks which is which yet — deriving the
                figure here would quietly print the wrong one for the shop.
                It belongs in billing (KS-21), where that exception lives.
              */}
              <dt class="text-console-ink-faint">จำนวนผู้พัก</dt>
              <dd class="m-0"><span class="font-figure">{lease.occupantCount}</span> คน</dd>

              {/*
                AC-2.3's move-in/move-out log. Shown only where a figure was
                actually recorded — a blank means nobody wrote it down, and
                rendering it as 0 would assert nothing changed hands, which is
                a different and common outcome (the `-` in จ่ายจริง).
              */}
              {lease.moveInDue !== null && (
                <Fragment>
                  <dt class="text-console-ink-faint">ยอดวันเข้า</dt>
                  <dd class="m-0 font-figure">
                    {formatBaht(lease.moveInDue)}
                    {lease.moveInPaid !== null && lease.moveInPaid !== lease.moveInDue && (
                      <span class="text-console-warn"> · จ่ายจริง {formatBaht(lease.moveInPaid)}</span>
                    )}
                  </dd>
                </Fragment>
              )}

              {lease.moveOutDue !== null && (
                <Fragment>
                  <dt class="text-console-ink-faint">ยอดวันออก</dt>
                  <dd class="m-0 font-figure">
                    <span class:list={[lease.moveOutDue < 0 ? 'text-console-ok' : 'text-console-crit']}>
                      {lease.moveOutDue < 0
                        ? `คืน ${formatBaht(Math.abs(lease.moveOutDue))}`
                        : `เก็บเพิ่ม ${formatBaht(lease.moveOutDue)}`}
                    </span>
                    {lease.moveOutPaid !== null && lease.moveOutPaid !== lease.moveOutDue && (
                      <span class="text-console-warn"> · จ่ายจริง {formatBaht(lease.moveOutPaid)}</span>
                    )}
                  </dd>
                </Fragment>
              )}
            </dl>
            {/*
              Lease-scoped, so the same link works from the room side and the
              tenant side. Shown on ended leases too — a wrong end date is
              exactly the thing someone comes here to correct.
            */}
            <p class="mb-0 mt-1">
              <a
                href={consolePath(`console/leases/${lease.id}/end`)}
                class="text-xs text-console-ink-soft underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
              >
                {lease.endDate ? 'แก้วันสิ้นสุด' : 'บันทึกวันสิ้นสุด'}
              </a>
            </p>
          </li>
        ))}
      </ul>
    )
  }
</DetailSection>
