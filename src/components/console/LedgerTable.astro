---
// src/components/console/LedgerTable.astro
import type { LedgerColumn, LedgerGroup } from '@/lib/models/ledger';
import { formatFigure, formatReadingFigure } from '@/lib/format/thai';
import { FOCUS, INPUT } from '@/lib/console/ui';
import StatusPill from './StatusPill.astro';

/**
 * The ruled ledger every list screen is written in.
 *
 * Drawn like a page of the notebook: a heavy ink rule at the top, a light
 * blue rule under every line, figures in a monospaced column so they line
 * up, and the room number in Mali at the start of each line — the way it
 * would be hand-written in the margin. A column keyed `room` is the room
 * number; that is the one rule for which column is hand-written.
 */

interface Props {
  columns: LedgerColumn[];
  groups: LedgerGroup[];
  /**
   * Spreadsheet look, for data entry (จดมิเตอร์, 7 พ.ย. 2569): ruled cells
   * that touch, inputs that fill their cell edge to edge with no rounding,
   * and every figure — typed or shown — right-aligned on the same padding so
   * the numbers in a row line up like Excel. Off everywhere else.
   */
  sheet?: boolean;
}

const { columns, groups, sheet = false } = Astro.props;
const showGroupHeadings = groups.length > 1 || groups.some((g) => g.label);
---

<div class="overflow-x-auto">
  <table class:list={['w-full border-collapse border-t-2 border-console-ink text-[15px]', sheet && 'sheet-table bg-console-card']}>
    <thead>
      <tr>
        {columns.map((column) => (
          <th
            scope="col"
            class:list={[
              'whitespace-nowrap border-b border-console-rule px-3 py-2 text-sm font-semibold text-console-ink-soft',
              column.align === 'right' ? 'text-right' : 'text-left',
              sheet && 'border border-console-line-strong bg-console-spine',
            ]}
          >
            {column.header}
          </th>
        ))}
      </tr>
    </thead>
    {groups.map((group) => (
      <tbody>
        {showGroupHeadings && (
          <tr>
            <th
              scope="rowgroup"
              colspan={columns.length}
              class="border-b border-console-rule bg-console-spine/70 px-3 pb-1 pt-3 text-left font-hand text-base font-semibold text-console-ink-soft"
            >
              {group.label}
            </th>
          </tr>
        )}
        {group.rows.map((row) => (
            <tr class="border-b border-console-rule">
              {columns.map((column, index) => {
                const cell = row.cells[column.key];
                if (!cell) {
                  throw new Error(
                    `LedgerTable: row "${row.id}" has no cell for column "${column.key}". ` +
                      `Every row must supply a cell for every column — use ` +
                      `{ kind: 'figure', value: null } to render an em dash for a genuinely absent value.`
                  );
                }
                if (index === 0 && row.href && cell.kind !== 'text') {
                  throw new Error(
                    `LedgerTable: row "${row.id}" sets href but its first column ("${column.key}") is a ` +
                      `${cell.kind} cell. Only a text cell in the first column renders the row link — ` +
                      `either make the first column a text cell, or remove href.`
                  );
                }
                const hand = column.key === 'room' && cell.kind === 'text';
                return (
                  <td
                    class:list={[
                      sheet
                        ? ['h-10 border border-console-line-strong align-middle', cell.kind === 'input' ? 'p-0' : 'px-3 py-0']
                        : 'h-[46px] px-3 py-1.5 align-middle',
                      column.align === 'right' && 'text-right',
                      (cell.kind === 'figure' || cell.kind === 'input') &&
                        'font-figure tabular-nums',
                      hand && 'whitespace-nowrap font-hand text-[17px] font-semibold',
                    ]}
                  >
                    {cell.kind === 'figure' &&
                      (cell.measured ? formatReadingFigure(cell.value) : formatFigure(cell.value))}
                    {cell.kind === 'input' && (
                      <input
                        type="text"
                        inputmode={cell.mode === 'text' ? undefined : 'decimal'}
                        name={cell.name}
                        value={cell.value}
                        aria-label={cell.label}
                        placeholder={cell.placeholder}
                        data-sheet-input={sheet ? column.key : undefined}
                        class:list={[
                          sheet
                            ? 'block h-10 w-full min-w-28 rounded-none border-0 bg-transparent px-3 text-[15px] text-console-ink outline-none focus:bg-console-highlight/25 focus:shadow-[inset_0_0_0_2px_#1E2D4A]'
                            : [INPUT, 'min-h-9 min-w-24 py-1'],
                          cell.mode === 'text' ? 'font-console' : 'font-figure tabular-nums',
                          column.align === 'right' && 'text-right',
                        ]}
                      />
                    )}
                    {cell.kind === 'pill' && <StatusPill tone={cell.tone} label={cell.label} />}
                    {cell.kind === 'link' && (
                      <a
                        href={cell.href}
                        class:list={['whitespace-nowrap font-semibold text-console-ink underline-offset-2 hover:underline', FOCUS]}
                      >
                        {cell.label}
                      </a>
                    )}
                    {cell.kind === 'text' && (
                      index === 0 && row.href ? (
                        <a
                          href={row.href}
                          class:list={['text-console-ink underline-offset-2 hover:underline', !hand && 'font-semibold', FOCUS]}
                        >
                          {cell.value}
                        </a>
                      ) : (
                        <span class={cell.muted ? 'text-sm text-console-ink-soft' : ''}>{cell.value}</span>
                      )
                    )}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>
