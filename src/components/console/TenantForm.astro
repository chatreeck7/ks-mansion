---
// src/components/console/TenantForm.astro
import ErrorSummary from './ErrorSummary.astro';
import FormActions from './FormActions.astro';
import FormField from './FormField.astro';
import { EMPTY_ADDRESS, type Tenant } from '@/lib/models/tenant';
import type { TenantDraft } from '@/lib/repositories/tenant-repository';

interface Props {
  /**
   * What to show in the fields. On a failed post this is what the person
   * typed, not what is on file — re-rendering the stored record would
   * discard their edits and leave them retyping an address to fix one cell.
   */
  values?: TenantDraft | Tenant | null;
  error?: string | null;
  submitLabel: string;
  cancelHref: string;
}

const { values, error, submitLabel, cancelHref } = Astro.props;

const v: TenantDraft = {
  fullName: values?.fullName ?? '',
  nickname: values?.nickname ?? '',
  idCardLast4: values?.idCardLast4 ?? '',
  phone: values?.phone ?? '',
  occupation: values?.occupation ?? '',
  evaluationGrade: values?.evaluationGrade ?? null,
  note: values?.note ?? '',
  address: values?.address ?? EMPTY_ADDRESS,
};

const GRADES = [
  { value: '', label: 'ยังไม่ประเมิน' },
  { value: 'A', label: 'A (ดีมาก)' },
  { value: 'B', label: 'B (ดี)' },
  { value: 'C', label: 'C (พอใช้ได้)' },
];

const CONTROL_CLASS =
  'rounded border border-console-sunk bg-console-card px-3 py-2 text-console-ink ' +
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule';
---

<ErrorSummary message={error} />

<!-- Plain POST to this same route. No client JS, so it works before hydration
     and with scripting off — see login.astro, which set this pattern. -->
<form method="POST" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  <FormField name="fullName" label="ชื่อ-นามสกุล" value={v.fullName} required autofocus
    hint="ตามที่เขียนในสัญญาเช่า" />

  <FormField name="nickname" label="ชื่อเล่น" value={v.nickname} span="half" />

  <FormField
    name="idCardLast4"
    label="บัตรประชาชน 4 ตัวท้าย"
    value={v.idCardLast4}
    span="half"
    inputmode="numeric"
    maxlength={4}
    hint="เก็บแค่ 4 ตัวท้าย ห้ามใส่เลขเต็ม — ชีตนี้ทุกคนที่มีสิทธิ์เปิดดูได้"
  />

  <FormField name="phone" label="โทรศัพท์" value={v.phone} type="tel" span="half" />

  <FormField name="occupation" label="อาชีพ" value={v.occupation} span="half"
    hint="พิมพ์ได้อิสระ เช่น ราชภัฏ/7-11" />

  <FormField name="evaluationGrade" label="ผลประเมิน" span="half">
    <select id="evaluationGrade" name="evaluationGrade" class={CONTROL_CLASS}>
      {
        GRADES.map((g) => (
          <option value={g.value} selected={(v.evaluationGrade ?? '') === g.value}>
            {g.label}
          </option>
        ))
      }
    </select>
  </FormField>

  <div class="sm:col-span-2">
    <h3 class="mb-2 font-figure text-xs font-semibold text-console-rule">
      ที่อยู่ตามทะเบียนบ้าน
    </h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <FormField name="address.houseNo" label="บ้านเลขที่" value={v.address.houseNo} span="half" />
      <FormField name="address.road" label="ถนน" value={v.address.road} span="half" />
      <FormField name="address.subdistrict" label="ตำบล" value={v.address.subdistrict} span="half" />
      <FormField name="address.district" label="อำเภอ" value={v.address.district} span="half" />
      <FormField name="address.province" label="จังหวัด" value={v.address.province} span="half" />
      <FormField
        name="address.postcode"
        label="รหัสไปรษณีย์"
        value={v.address.postcode}
        span="half"
        inputmode="numeric"
        maxlength={5}
      />
    </div>
  </div>

  <FormField name="note" label="หมายเหตุ">
    <textarea id="note" name="note" rows="2" class={CONTROL_CLASS}>{v.note}</textarea>
  </FormField>

  <FormActions submitLabel={submitLabel} cancelHref={cancelHref} />
</form>
