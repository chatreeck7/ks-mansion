---
// src/components/console/CollectionSheet.astro
import { collectionHeading, type CollectionSheet } from '@/lib/console/collection-sheet';
import { formatBaht, formatThaiDate } from '@/lib/format/thai';
import { cycleLabel } from '@/lib/models/billing-cycle';

/**
 * แบบฟอร์มเก็บเงินค่าห้อง, the sheet carried round the building (KS-25).
 *
 * **Drawn as the paper, not as a console table.** Every cell ruled, the
 * form's own header line across the top, a รวม row at the foot — because an
 * admin reading across a row is reading by position. Rendered here rather
 * than through `LedgerTable` for the same reason the bill is: the ledger is
 * the console's house style for screens you *read*, and this is a form you
 * *fill in*.
 *
 * **Lifted out of the page for KS-30.** The combined export renders the same
 * sheet as one section of a longer document, and a second copy of this
 * markup would drift from the one an admin actually prints — the identical
 * argument that put the bill in `BillDocument.astro`.
 *
 * Carries no chrome: no picker, no print button, no totals panel. Those
 * belong to the screen around it, and the screen is not what gets carried
 * round the building.
 */

interface Props {
  sheet: CollectionSheet;
}

const { sheet } = Astro.props;

/** Ruled like the paper: every cell bordered, nothing relying on colour. */
const CELL = 'border border-console-rule/60 px-1.5 py-1';
/**
 * The first two columns are held narrow on purpose.
 *
 * Left to spread, `w-full` gives ห้อง and ค่าห้องฯ a third of the page each
 * and squeezes the sixteen day columns into the rest — which is backwards:
 * the day grid is the part that gets written in, and the room number is four
 * characters. หมายเหตุ takes whatever is left, as it does on the paper.
 */
const ROOM_COL = 'w-16';
const DUE_COL = 'w-24';
---

<article class="text-sm">
  <header class="mb-2">
    <p class="mb-0 font-semibold text-console-ink">{collectionHeading(sheet.cycle)}</p>
    <p class="mb-0 text-console-ink-soft">{cycleLabel(sheet.cycle)}</p>
  </header>

  <div class="overflow-x-auto">
    <table class="w-full border-collapse">
      <thead>
        <tr>
          <th scope="col" class={`${CELL} ${ROOM_COL} text-center font-semibold text-console-ink`}>
            ห้อง
          </th>
          <th scope="col" class={`${CELL} ${DUE_COL} text-center font-semibold text-console-ink`}>
            ค่าห้องฯ
          </th>
          {sheet.days.map((day) => (
            <th
              scope="col"
              class={`${CELL} w-8 text-center font-figure text-xs font-semibold text-console-ink`}
            >
              {day.dayOfMonth}
              {day.monthLabel && (
                <span class="block text-[0.6rem] font-normal text-console-ink-faint">
                  {day.monthLabel}
                </span>
              )}
            </th>
          ))}
          <th scope="col" class={`${CELL} text-center font-semibold text-console-ink`}>
            หมายเหตุ
          </th>
        </tr>
      </thead>
      <tbody>
        {sheet.rows.map((row) => (
          <tr>
            <td class={`${CELL} ${ROOM_COL} text-center font-figure text-console-ink`}>
              {row.roomLabel}
            </td>
            {/* Blank, not a zero and not a dash: the paper leaves ค่าห้องฯ
                empty for a room with no bill this cycle. */}
            <td class={`${CELL} ${DUE_COL} text-right font-figure tabular-nums text-console-ink`}>
              {row.due === null ? '' : formatBaht(row.due)}
            </td>
            {sheet.days.map((day) => {
              const amount = row.byDay.get(day.key);
              return (
                <td class={`${CELL} text-right font-figure text-xs tabular-nums text-console-ink`}>
                  {amount === undefined ? '' : formatBaht(amount)}
                </td>
              );
            })}
            <td class={`${CELL} text-console-ink`}>{row.note ?? ''}</td>
          </tr>
        ))}
        <tr>
          <td class={`${CELL} ${ROOM_COL} text-center font-semibold text-console-ink`}>รวม</td>
          <td
            class={`${CELL} ${DUE_COL} text-right font-figure text-base font-semibold tabular-nums text-console-ink`}
          >
            {formatBaht(sheet.billed)}
          </td>
          {sheet.days.map(() => <td class={CELL}></td>)}
          <td class={CELL}></td>
        </tr>
      </tbody>
    </table>
  </div>

  {/* A footnote rather than a seventeenth column. The paper has nowhere to
      put a late payment, and dropping it would show a balance the tenant
      has already settled — so it prints here, with the grid left alone. */}
  {sheet.late.length > 0 && (
    <section class="mt-3">
      <p class="mb-1 font-semibold text-console-ink">รับนอกช่วง</p>
      <ul class="mb-0 list-disc ps-5 text-console-ink-soft">
        {sheet.late.map((row) => (
          <li>
            {row.roomLabel} — {formatBaht(row.outsideWindow)} บาท
            {' '}({row.outsideWindowDates.map((at) => formatThaiDate(at)).join(', ')})
          </li>
        ))}
      </ul>
    </section>
  )}
</article>
