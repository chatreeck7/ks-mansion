---
import { getLocaleFromUrl, useTranslations } from '../i18n';

const base = import.meta.env.BASE_URL;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Helper to get localized URL
const getUrl = (path: string) => locale === 'th' ? `${base}${path}` : `${base}/en${path}`;
---

<footer class="bg-primary text-white pt-16 pb-5 mt-20">
  <div class="container-custom">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">
      <div class="footer-section">
        <h4 class="mb-5 text-accent text-lg">{t('site.title')}</h4>
        <p class="text-white/80">{t('footer.tagline')}</p>
      </div>

      <div class="footer-section">
        <h4 class="mb-5 text-accent text-lg">{t('footer.quickLinks')}</h4>
        <ul class="list-none space-y-2">
          <li>
            <a
              href={getUrl('/accommodations')}
              class="text-white hover:text-accent transition-colors no-underline"
              >{t('nav.accommodations')}</a>
          </li>
          <li>
            <a
              href={getUrl('/experiences')}
              class="text-white hover:text-accent transition-colors no-underline"
              >{t('nav.experiences')}</a>
          </li>
          <li>
            <a
              href={getUrl('/dining')}
              class="text-white hover:text-accent transition-colors no-underline"
              >{t('nav.dining')}</a>
          </li>
          <li>
            <a
              href={getUrl('/gallery')}
              class="text-white hover:text-accent transition-colors no-underline"
              >{t('nav.gallery')}</a>
          </li>
        </ul>
      </div>

      <div class="footer-section">
        <h4 class="mb-5 text-accent text-lg">{t('footer.contact')}</h4>
        <ul class="list-none space-y-2">
          <li>
            <a
              href={getUrl('/contact')}
              class="text-white hover:text-accent transition-colors no-underline"
              >{t('footer.getInTouch')}</a>
          </li>
          <li>
            <a
              href={getUrl('/reservations')}
              class="text-white hover:text-accent transition-colors no-underline"
              >{t('footer.reservations')}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="text-center pt-5 border-t border-white/10">
      <p class="text-white/70">{t('footer.copyright')}</p>
    </div>
  </div>
</footer>
