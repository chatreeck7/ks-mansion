---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getLocaleFromUrl, useTranslations } from '../../i18n';

const base = import.meta.env.BASE_URL;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const getUrl = (path: string) => locale === 'th' ? `${base}${path}` : `${base}/en${path}`;

const experiences = [
  {
    title: t('experiences.items.spaWellness.title'),
    description: t('experiences.items.spaWellness.description'),
    features: ['Signature massage treatments', 'Yoga and meditation sessions', 'Hydrotherapy facilities', 'Personalized wellness programs'],
    gradient: 'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)',
  },
  {
    title: t('experiences.items.estateTours.title'),
    description: t('experiences.items.estateTours.description'),
    features: ['Historical architecture tour', 'Garden and grounds exploration', 'Art collection viewing', 'Heritage storytelling sessions'],
    gradient: 'linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%)',
  },
  {
    title: t('experiences.items.wineTasting.title'),
    description: t('experiences.items.wineTasting.description'),
    features: ['Private cellar tours', 'Expert-led tastings', 'Food pairing sessions', 'Vintage collection access'],
    gradient: 'linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)',
  },
  {
    title: t('experiences.items.outdoorAdventures.title'),
    description: t('experiences.items.outdoorAdventures.description'),
    features: ['Guided nature walks', 'Tennis and croquet', 'Horseback riding', 'Cycling tours'],
    gradient: 'linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%)',
  },
  {
    title: t('experiences.items.culturalImmersion.title'),
    description: t('experiences.items.culturalImmersion.description'),
    features: ['Art workshops', 'Cooking classes', 'Music performances', 'Craft demonstrations'],
    gradient: 'linear-gradient(135deg, #fa8bff 0%, #2bd2ff 100%)',
  },
  {
    title: t('experiences.items.privateEvents.title'),
    description: t('experiences.items.privateEvents.description'),
    features: ['Weddings and ceremonies', 'Corporate retreats', 'Anniversary celebrations', 'Custom event planning'],
    gradient: 'linear-gradient(135deg, #fbc2eb 0%, #a6c1ee 100%)',
  },
];
---

<BaseLayout title={t('experiences.pageTitle')} description={t('experiences.pageDescription')}>
  <Navigation />

  <!-- Page Header -->
  <section class="page-header">
    <div class="page-header-content">
      <h1 class="text-4xl md:text-5xl font-light mb-4 tracking-wide">{t('experiences.title')}</h1>
      <p class="text-lg md:text-xl">{t('experiences.subtitle')}</p>
    </div>
  </section>

  <!-- Experiences Content -->
  <section class="py-20">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2>{t('experiences.intro.title')}</h2>
        <p class="text-lg">{t('experiences.intro.description')}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {experiences.map((exp) => (
          <div class="bg-white rounded overflow-hidden transition-all hover:-translate-y-2 hover:shadow-xl">
            <div class="w-full h-[300px]">
              <div class="placeholder-img" style={{ background: exp.gradient }}>
                <span>{exp.title}</span>
              </div>
            </div>
            <div class="p-8">
              <h3 class="text-2xl text-primary mb-4">{exp.title}</h3>
              <p class="mb-5 leading-relaxed">{exp.description}</p>
              <ul class="list-none space-y-2">
                {exp.features.map((feature) => (
                  <li class="pl-6 relative text-text-light before:content-['•'] before:absolute before:left-0 before:text-accent before:text-2xl before:leading-[0.8]">
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- Call to Action -->
      <div class="text-center mt-20 p-16 bg-bg-light rounded">
        <h2 class="mb-5">{t('experiences.cta.title')}</h2>
        <p class="text-lg mb-8">{t('experiences.cta.description')}</p>
        <a href={getUrl('/contact')} class="btn btn-primary">{t('experiences.cta.button')}</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
