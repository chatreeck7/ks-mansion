---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getLocaleFromUrl, useTranslations } from '../../i18n';

const base = import.meta.env.BASE_URL;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const getUrl = (path: string) => locale === 'th' ? `${base}${path}` : `${base}/en${path}`;

const venues = [
  {
    name: t('dining.venues.grandDiningRoom.name'),
    meta: t('dining.venues.grandDiningRoom.meta'),
    description: t('dining.venues.grandDiningRoom.description'),
    details: [
      { label: t('dining.details.dinner'), value: '6:00 PM - 10:00 PM' },
      { label: t('dining.details.capacity'), value: '40 guests' },
      { label: t('dining.details.reservations'), value: t('dining.details.required') },
    ],
    gradient: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
  },
  {
    name: t('dining.venues.gardenTerrace.name'),
    meta: t('dining.venues.gardenTerrace.meta'),
    description: t('dining.venues.gardenTerrace.description'),
    details: [
      { label: t('dining.details.breakfast'), value: '7:00 AM - 11:00 AM' },
      { label: t('dining.details.lunch'), value: '12:00 PM - 3:00 PM' },
      { label: t('dining.details.afternoonTea'), value: '3:00 PM - 5:00 PM' },
    ],
    gradient: 'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
  },
  {
    name: t('dining.venues.wineCellar.name'),
    meta: t('dining.venues.wineCellar.meta'),
    description: t('dining.venues.wineCellar.description'),
    details: [
      { label: t('dining.details.capacity'), value: 'Up to 12 guests' },
      { label: t('dining.details.service'), value: 'Private chef experience' },
      { label: t('dining.details.booking'), value: '48 hours advance notice' },
    ],
    gradient: 'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
  },
  {
    name: t('dining.venues.inRoomDining.name'),
    meta: t('dining.venues.inRoomDining.meta'),
    description: t('dining.venues.inRoomDining.description'),
    details: [
      { label: t('dining.details.service'), value: '24 hours' },
      { label: t('dining.details.menu'), value: 'Full selection available' },
      { label: t('dining.details.setup'), value: 'Elegant presentation' },
    ],
    gradient: 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
  },
];

const specialOfferings = [
  { title: t('dining.specialExperiences.chefsTable.title'), description: t('dining.specialExperiences.chefsTable.description') },
  { title: t('dining.specialExperiences.cookingClasses.title'), description: t('dining.specialExperiences.cookingClasses.description') },
  { title: t('dining.specialExperiences.winePairing.title'), description: t('dining.specialExperiences.winePairing.description') },
  { title: t('dining.specialExperiences.privatePicnics.title'), description: t('dining.specialExperiences.privatePicnics.description') },
];
---

<BaseLayout title={t('dining.pageTitle')} description={t('dining.pageDescription')}>
  <Navigation />

  <!-- Page Header -->
  <section class="page-header">
    <div class="page-header-content">
      <h1 class="text-4xl md:text-5xl font-light mb-4 tracking-wide">{t('dining.title')}</h1>
      <p class="text-lg md:text-xl">{t('dining.subtitle')}</p>
    </div>
  </section>

  <!-- Dining Content -->
  <section class="py-20">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2>{t('dining.culinaryExcellence.title')}</h2>
        <p class="text-lg">{t('dining.culinaryExcellence.description')}</p>
      </div>

      <!-- Dining Venues -->
      <div class="space-y-16 mb-20">
        {venues.map((venue, index) => (
          <div class={`grid grid-cols-1 md:grid-cols-2 gap-10 items-center`}>
            <div class={`w-full h-[400px] rounded overflow-hidden ${index % 2 === 1 ? 'md:order-2' : ''}`}>
              <div class="placeholder-img" style={{ background: venue.gradient }}>
                <span>{venue.name}</span>
              </div>
            </div>
            <div class={index % 2 === 1 ? 'md:order-1' : ''}>
              <h3 class="text-3xl text-primary mb-2">{venue.name}</h3>
              <p class="text-accent font-medium text-sm uppercase tracking-widest mb-5">{venue.meta}</p>
              <p class="mb-6 leading-relaxed">{venue.description}</p>
              <div class="pt-6 border-t border-gray-200 space-y-2">
                {venue.details.map((detail) => (
                  <div class="text-text-light">
                    <strong class="text-primary">{detail.label}:</strong> {detail.value}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Special Offerings -->
      <div class="text-center mb-12">
        <h2 class="mb-10">{t('dining.specialExperiences.title')}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
        {specialOfferings.map((offering) => (
          <div class="bg-bg-light p-8 rounded transition-all hover:-translate-y-2 hover:border-accent border border-transparent">
            <h4 class="text-primary mb-4 text-lg">{offering.title}</h4>
            <p class="text-sm text-text-light">{offering.description}</p>
          </div>
        ))}
      </div>

      <!-- Dining CTA -->
      <div class="text-center mt-20 p-16 bg-bg-light rounded">
        <h2 class="mb-5">{t('dining.cta.title')}</h2>
        <p class="text-lg mb-8">{t('dining.cta.description')}</p>
        <a href={getUrl('/contact')} class="btn btn-primary">{t('dining.cta.button')}</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
