---
// src/pages/console/tenants/[tenant].astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import DetailSheet from '@/components/console/DetailSheet.astro';
import DetailSection from '@/components/console/DetailSection.astro';
import LeaseSection from '@/components/console/LeaseSection.astro';
import { displayName, formatAddress, formatGrade, maskIdCard } from '@/lib/models/tenant';
import { consolePath } from '@/lib/console/paths';
import { getLeaseRepository, getRoomRepository, getTenantRepository } from '@/lib/repositories';

const env = Astro.locals.runtime?.env;
const tenant = await getTenantRepository(env).getTenant(Astro.params.tenant!);

if (!tenant) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const leases = await getLeaseRepository(env).listLeasesForTenant(tenant.id);
const rooms = leases.length > 0 ? await getRoomRepository(env).listRooms() : [];
const roomLabelById = new Map(rooms.map((r) => [r.id, r.label]));
---

<ConsoleFrame title={`ผู้เช่า ${tenant.fullName}`} activeSection="tenants">
  <DetailSheet title={displayName(tenant)} meta="ข้อมูลผู้เช่า">
    <DetailSection heading="ข้อมูลติดต่อ">
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-console-ink-faint">โทรศัพท์</dt>
        <dd>{tenant.phone || '—'}</dd>
        <dt class="text-console-ink-faint">ที่อยู่ตามทะเบียนบ้าน</dt>
        <dd>{formatAddress(tenant.address)}</dd>
        <dt class="text-console-ink-faint">อาชีพ</dt>
        <dd>{tenant.occupation || '—'}</dd>
      </dl>
    </DetailSection>

    <DetailSection heading="ผลประเมิน">
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-console-ink-faint">เกรด</dt>
        <dd>{formatGrade(tenant.evaluationGrade)}</dd>
        <dt class="text-console-ink-faint">หมายเหตุ</dt>
        <dd>{tenant.note || '—'}</dd>
      </dl>
    </DetailSection>

    <DetailSection heading="เอกสาร">
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-console-ink-faint">บัตรประชาชน</dt>
        <dd class="font-figure">{maskIdCard(tenant.idCardLast4)}</dd>
      </dl>
      <p class="mt-2 text-xs text-console-ink-faint">
        เก็บเฉพาะเลข 4 หลักท้าย เพื่อใช้ตรวจสอบกับสัญญาเช่าเท่านั้น
      </p>
    </DetailSection>

    <LeaseSection
      leases={leases}
      counterpartLabel="ห้อง"
      counterpartFor={(lease) => roomLabelById.get(lease.roomId) ?? lease.roomId}
      emptyMessage="ยังไม่มีสัญญาเช่าสำหรับผู้เช่ารายนี้"
    />
  </DetailSheet>

  <p class="mt-4 mb-0 leading-none text-console-ink-soft">
    <a
      href={consolePath('console/tenants')}
      class="text-sm underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
      >← กลับไปรายชื่อผู้เช่า</a
    >
  </p>
</ConsoleFrame>
