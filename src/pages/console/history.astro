---
// src/pages/console/history.astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import PageHeader from '@/components/console/PageHeader.astro';
import StatusPill from '@/components/console/StatusPill.astro';
import { cycleHistory, type CycleSummary } from '@/lib/console/history';
import { notebookMonth, shortCycleLabel } from '@/lib/console/logbook';
import { consolePath } from '@/lib/console/paths';
import { FOCUS } from '@/lib/console/ui';
import { formatBaht } from '@/lib/format/thai';
import type { PillTone } from '@/lib/models/pill-tone';
import { getBillRepository, getPaymentRepository } from '@/lib/repositories';

/**
 * สมุดย้อนหลัง — the notebook's earlier pages.
 *
 * Every step screen opens on the cycle you are in, because that is the month
 * being worked. This page is the way back: one line per cycle with what was
 * billed and what came in, and links that open each step screen on that
 * month (`?cycle=`), so looking at June is the same screen as working
 * October.
 *
 * Read-only, and nothing on it is stored — it is added up from the bills and
 * payments on file, with the same `settle` the payment screens use.
 */

const env = Astro.locals.runtime?.env;
const now = new Date();

const [bills, payments] = await Promise.all([
  getBillRepository(env).listBills(),
  getPaymentRepository(env).listPayments(),
]);
const history = cycleHistory(bills, payments, now);

function status(row: CycleSummary): { tone: PillTone; label: string } {
  if (row.billCount === 0) return { tone: 'mute', label: 'ไม่ได้ออกบิล' };
  const owing = row.billCount - row.paidCount;
  if (owing === 0) return { tone: 'ok', label: 'รับครบ' };
  return { tone: row.current ? 'info' : 'warn', label: `ค้าง ${owing} ห้อง` };
}

const LINKS = [
  { path: 'console/bills', label: 'บิล' },
  { path: 'console/payments', label: 'รับเงิน' },
  { path: 'console/collection', label: 'ใบเก็บเงิน' },
  { path: 'console/documents', label: 'เอกสาร' },
] as const;
---

<ConsoleFrame title="ย้อนหลัง" activeSection="history">
  <PageHeader
    title="สมุดย้อนหลัง"
    subtitle="ทุกเดือนที่ผ่านมา ยอดบิลและเงินที่รับ — กดปุ่มของเดือนไหนก็เปิดหน้านั้นของเดือนนั้น"
  />

  <ul class="m-0 flex list-none flex-col gap-2 p-0 desk:gap-0 desk:border-t-2 desk:border-console-ink">
    {history.map((row) => {
      const pill = status(row);
      const query = `?cycle=${row.cycle.id}`;
      return (
        <li
          data-history-row={row.cycle.id}
          class="flex flex-col gap-2 rounded-xl border border-console-line bg-console-card p-3 desk:grid desk:grid-cols-[minmax(0,1.2fr)_minmax(0,1.6fr)_auto] desk:items-center desk:gap-4 desk:rounded-none desk:border-0 desk:border-b desk:border-console-rule desk:bg-transparent desk:px-2 desk:py-3"
        >
          <div class="flex flex-col">
            <span class="flex flex-wrap items-center gap-2">
              <span class="font-hand text-lg font-semibold">{notebookMonth(row.cycle)}</span>
              {row.current && <StatusPill tone="info" label="เดือนนี้" />}
            </span>
            <span class="text-sm text-console-ink-soft">{shortCycleLabel(row.cycle)}</span>
          </div>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[15px]">
            <StatusPill tone={pill.tone} label={pill.label} />
            {row.billCount > 0 && (
              <>
                <span class="text-console-ink-soft">
                  บิล {row.billCount} ใบ · <span class="font-figure text-console-ink">{formatBaht(row.billed)}</span>
                </span>
                <span class="text-console-ok">
                  รับแล้ว <span class="font-figure">{formatBaht(row.collected)}</span>
                </span>
                {row.outstanding > 0 && (
                  <span class="text-console-ink-soft">
                    ค้าง <span class="font-figure font-semibold text-console-ink">{formatBaht(row.outstanding)}</span>
                  </span>
                )}
              </>
            )}
          </div>

          <nav aria-label={`เปิด ${notebookMonth(row.cycle)}`} class="flex flex-wrap gap-1.5">
            {LINKS.map((link) => (
              <a
                href={`${consolePath(link.path)}${query}`}
                class:list={[
                  'inline-flex min-h-11 items-center rounded-lg border border-console-line px-3 text-sm font-medium text-console-ink no-underline hover:bg-console-ink/5 desk:min-h-9',
                  FOCUS,
                ]}
              >
                {link.label}
              </a>
            ))}
          </nav>
        </li>
      );
    })}
  </ul>
</ConsoleFrame>
