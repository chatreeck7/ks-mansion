---
// src/pages/console/leases/[lease]/end.astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import DetailSheet from '@/components/console/DetailSheet.astro';
import DetailSection from '@/components/console/DetailSection.astro';
import ErrorSummary from '@/components/console/ErrorSummary.astro';
import FormActions from '@/components/console/FormActions.astro';
import FormField from '@/components/console/FormField.astro';
import {
  endReasonLabel,
  settleDeposit,
  settlementLabel,
  type LeaseEndReason,
} from '@/lib/models/lease';
import { formatBaht, formatThaiDate } from '@/lib/format/thai';
import { displayName } from '@/lib/models/tenant';
import { consolePath } from '@/lib/console/paths';
import { dateFromInput, dateToInput, optionalNumberField } from '@/lib/console/lease-form';
import { getLeaseRepository, getRoomRepository, getTenantRepository } from '@/lib/repositories';

const env = Astro.locals.runtime?.env;
const repository = getLeaseRepository(env);

const lease = await repository.getLease(Astro.params.lease!);
if (!lease) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const [room, tenant] = await Promise.all([
  getRoomRepository(env).getRoom(lease.roomId),
  getTenantRepository(env).getTenant(lease.tenantId),
]);

const roomHref = consolePath(`console/rooms/${lease.roomId}`);

let error: string | null = null;
let endDateValue = dateToInput(lease.endDate);
let endReasonValue: string = lease.endReason ?? '';
let moveOutPaidValue: string = lease.moveOutPaid === null ? '' : String(lease.moveOutPaid);
// What the tenant owes: damage plus unpaid bills, as one figure. Not stored —
// only the settlement it produces is (AC-2.5). KS-21 will eventually supply
// the unpaid half, and `settleDeposit` will not need to change when it does.
let owedValue = '';
// The settlement already on file, so revisiting the screen shows the outcome
// rather than an empty form that looks like nothing was ever settled.
let settledAmount: number | null = lease.moveOutDue;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  endDateValue = String(form.get('endDate') ?? '').trim();
  endReasonValue = String(form.get('endReason') ?? '').trim();
  owedValue = String(form.get('owed') ?? '').trim();
  moveOutPaidValue = String(form.get('moveOutPaid') ?? '').trim();

  // Blank owed leaves the settlement alone rather than computing against zero,
  // which would read as "the whole deposit is refundable" on a screen someone
  // opened only to fix a date.
  if (owedValue !== '') settledAmount = settleDeposit(lease.deposit, Number(owedValue)).amount;

  try {
    // A room transfer (KS-64) is still its own card — this records how a
    // tenancy ended, not what it continues into.
    await repository.updateLease(lease.id, {
      endDate: dateFromInput(endDateValue),
      endReason: (endReasonValue || null) as LeaseEndReason | null,
      moveOutDue: settledAmount,
      moveOutPaid: optionalNumberField(form, 'moveOutPaid'),
    });
    return Astro.redirect(roomHref, 303);
  } catch (cause) {
    // Includes the store's refusal of a reason with no end date — a lease
    // cannot have ended a particular way and still be running. Surfaced
    // rather than re-checked here, so the rule keeps living in one place.
    error = cause instanceof Error ? cause.message : String(cause);
  }
}

const END_REASONS: readonly LeaseEndReason[] = ['normal', 'absconded'];
---

<ConsoleFrame title="สิ้นสุดสัญญาเช่า" activeSection="rooms">
  <DetailSheet title="สิ้นสุดสัญญาเช่า" meta={room?.label ?? lease.roomId}>
    <DetailSection heading="สัญญา">
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-console-ink-faint">ห้อง</dt>
        <dd>{room?.label ?? lease.roomId}</dd>
        <dt class="text-console-ink-faint">ผู้เช่า</dt>
        <dd>{tenant ? displayName(tenant) : lease.tenantId}</dd>
        <dt class="text-console-ink-faint">วันเริ่มเช่า</dt>
        <dd>{formatThaiDate(lease.startDate)}</dd>
      </dl>
    </DetailSection>

    <DetailSection heading="วันสิ้นสุด">
      <ErrorSummary message={error} />

      <form method="POST" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <FormField
          name="endDate"
          label="วันสิ้นสุดสัญญา"
          type="date"
          value={endDateValue}
          span="half"
          autofocus
          hint="เว้นว่างไว้ ถ้าต้องการยกเลิกวันสิ้นสุดและให้สัญญาเดินต่อ"
        />

        <FormField name="endReason" label="สาเหตุที่สิ้นสุด" span="half">
          <select
            id="endReason"
            name="endReason"
            class="rounded border border-console-sunk bg-console-card px-3 py-2 text-console-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
          >
            <option value="" selected={endReasonValue === ''}>ไม่ระบุ</option>
            {
              END_REASONS.map((reason) => (
                <option value={reason} selected={reason === endReasonValue}>
                  {endReasonLabel(reason)}
                </option>
              ))
            }
          </select>
        </FormField>

        <div class="sm:col-span-2">
          <h3 class="mb-2 font-figure text-xs font-semibold text-console-rule">
            หักเงินประกัน
          </h3>

          <dl class="mb-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
            <dt class="text-console-ink-faint">เงินประกันที่ถือไว้</dt>
            <dd class="m-0 font-figure">{formatBaht(lease.deposit)}</dd>
            {
              settledAmount !== null && (
                <Fragment>
                  <dt class="text-console-ink-faint">ผลหักล้างที่บันทึกไว้</dt>
                  <dd
                    class:list={[
                      'm-0 font-figure',
                      settledAmount > 0 ? 'text-console-crit' : 'text-console-ok',
                    ]}
                  >
                    {settlementLabel(settledAmount)}
                  </dd>
                </Fragment>
              )
            }
          </dl>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <FormField
              name="owed"
              label="ยอดที่ค้างทั้งหมด"
              type="number"
              value={owedValue}
              span="half"
              min={0}
              inputmode="numeric"
              hint="ค่าเสียหาย + ค่าเช่าค้าง รวมเป็นยอดเดียว — คอนโซลจะหักกับเงินประกันให้เอง"
            />
            <FormField
              name="moveOutPaid"
              label="จ่ายจริง"
              type="number"
              value={moveOutPaidValue}
              span="half"
              inputmode="numeric"
              hint="ใส่ 0 ถ้าเรียกเก็บแล้วไม่ได้รับ — ต่างจากเว้นว่างที่แปลว่ายังไม่ได้บันทึก"
            />
          </div>

          <p class="mt-2 text-xs text-console-ink-faint">
            ค้างมากกว่าเงินประกัน → <strong>เก็บเพิ่ม</strong> (ยึดเงินประกันทั้งหมด) ·
            ค้างน้อยกว่า → <strong>คืน</strong> ส่วนที่เหลือ
          </p>
        </div>

        <FormActions submitLabel="บันทึก" cancelHref={roomHref} />
      </form>

      <p class="mt-3 text-xs text-console-ink-faint">
        การบันทึกวันสิ้นสุดไม่ได้ลบสัญญา ประวัติยังอยู่ครบ —
        ส่วนการย้ายห้องจะมาทีหลัง
      </p>
      <p class="mt-1 text-xs text-console-ink-faint">
        ถ้าระบุสาเหตุ ต้องมีวันสิ้นสุดด้วย — สัญญาที่ยังเดินอยู่จะสิ้นสุดด้วยสาเหตุใดไม่ได้
      </p>
    </DetailSection>
  </DetailSheet>

  <p class="mt-4 mb-0 leading-none text-console-ink-soft">
    <a
      href={roomHref}
      class="text-sm underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
      >← กลับไปหน้าห้อง</a
    >
  </p>
</ConsoleFrame>
