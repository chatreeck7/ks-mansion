---
// src/pages/console/leases/[lease]/details.astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import DetailSection from '@/components/console/DetailSection.astro';
import DetailSheet from '@/components/console/DetailSheet.astro';
import ErrorSummary from '@/components/console/ErrorSummary.astro';
import FormActions from '@/components/console/FormActions.astro';
import FormField from '@/components/console/FormField.astro';
import { dateFromInput, dateToInput, optionalNumberField } from '@/lib/console/lease-form';
import { consolePath } from '@/lib/console/paths';
import { getLeaseRepository, getRoomRepository } from '@/lib/repositories';

/**
 * The contract-only details of an existing lease (KS-31): วันทำสัญญา, the
 * second tenant and the booking deposit.
 *
 * Narrow on purpose. Rent, deposit and occupants are billing inputs with
 * their own history; this screen changes only what the paper contract prints,
 * so editing it can never re-price a bill.
 */

const env = Astro.locals.runtime?.env;
const repository = getLeaseRepository(env);
const lease = await repository.getLease(Astro.params.lease!);
if (!lease) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
const room = await getRoomRepository(env).getRoom(lease.roomId);
const contractHref = consolePath(`console/leases/${lease.id}/contract`);

let error: string | null = null;
let values = {
  signedDate: dateToInput(lease.signedDate),
  coTenantName: lease.coTenantName ?? '',
  bookingFee: lease.bookingFee === null ? '' : String(lease.bookingFee),
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (field: string) => String(form.get(field) ?? '').trim();
  values = { signedDate: text('signedDate'), coTenantName: text('coTenantName'), bookingFee: text('bookingFee') };
  try {
    await repository.updateLease(lease.id, {
      signedDate: dateFromInput(values.signedDate),
      coTenantName: values.coTenantName || null,
      bookingFee: optionalNumberField(form, 'bookingFee'),
    });
    return Astro.redirect(contractHref, 303);
  } catch (cause) {
    error = cause instanceof Error ? cause.message : String(cause);
  }
}
---

<ConsoleFrame title={`ข้อมูลสัญญา ห้อง ${room?.label ?? lease.roomId}`} activeSection="tenants" width="reading">
  <a href={contractHref} class="mb-3 inline-flex min-h-11 items-center text-base font-medium text-console-ink-soft no-underline hover:text-console-ink">← กลับไปสัญญา</a>
  <DetailSheet title={`ห้อง ${room?.label ?? lease.roomId}`} meta="ข้อมูลที่พิมพ์ในสัญญาเช่าเท่านั้น — ไม่กระทบบิล">
    <DetailSection heading="ข้อมูลสัญญา">
      <ErrorSummary message={error} />
      <form method="POST" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <FormField name="signedDate" label="วันที่ทำสัญญา" type="date" value={values.signedDate} span="half"
          hint="ถ้าเว้นว่าง สัญญาจะลงวันเริ่มเช่าแทน" />
        <FormField name="bookingFee" label="ค่ามัดจำ/จองห้อง" type="number" value={values.bookingFee} span="half" min={0} inputmode="numeric" />
        <FormField name="coTenantName" label="ผู้เช่าคนที่ 2" value={values.coTenantName} hint="เว้นว่างถ้าไม่มี" />
        <FormActions submitLabel="บันทึก" cancelHref={contractHref} />
      </form>
    </DetailSection>
  </DetailSheet>
</ConsoleFrame>
