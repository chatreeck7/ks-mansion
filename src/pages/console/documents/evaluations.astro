---
// src/pages/console/documents/evaluations.astro
import DateInput from '@/components/console/DateInput.astro';
import EvaluationReport from '@/components/console/EvaluationReport.astro';
import PrintShell from '@/components/console/PrintShell.astro';
import { evaluationReportFor } from '@/lib/console/evaluation-report';
import { dateFromInput, dateToInput } from '@/lib/console/lease-form';
import { letterheadFrom } from '@/lib/console/letterhead';
import { buttonClass } from '@/lib/console/ui';
import { getLeaseRepository, getRoomRepository, getSettingsRepository, getTenantRepository } from '@/lib/repositories';

/**
 * ผลประเมินผู้เช่า (KS-15), as of a day — today unless `?date=` says
 * otherwise, so last month's sheet can be reprinted as it stood.
 * Grades are edited on each tenant's profile; this page only reads them.
 */
const env = Astro.locals.runtime?.env;
const asOf = dateFromInput(Astro.url.searchParams.get('date') ?? '') ?? new Date();
const [rooms, leases, tenants, settings] = await Promise.all([
  getRoomRepository(env).listRooms(),
  getLeaseRepository(env).listLeases(),
  getTenantRepository(env).listTenants(),
  getSettingsRepository(env).resolveSettings(),
]);
const report = evaluationReportFor(rooms, leases, tenants, asOf);
---

<PrintShell
  title="ผลประเมินผู้เช่า"
  building={letterheadFrom(env, settings).name}
  hint="แก้เกรด อาชีพ และเบอร์โทรได้ที่โปรไฟล์ผู้เช่าแต่ละคน · จำนวนผู้พักมาจากสัญญาเช่า"
>
  <form slot="controls" method="GET" class="flex flex-wrap items-start gap-2">
    <label class="flex flex-col gap-1 text-[15px] font-medium text-console-ink-soft">
      ณ วันที่
      <DateInput name="date" value={dateToInput(asOf)} width="fit" />
    </label>
    <button type="submit" class:list={[buttonClass('secondary', 'md', false), 'mt-7']}>ดู</button>
  </form>
  <EvaluationReport {report} />
</PrintShell>
