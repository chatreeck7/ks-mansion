---
// src/pages/console/documents/evaluations.astro
import EvaluationReport from '@/components/console/EvaluationReport.astro';
import ConsoleLayout from '@/layouts/ConsoleLayout.astro';
import { evaluationReportFor } from '@/lib/console/evaluation-report';
import { dateFromInput, dateToInput } from '@/lib/console/lease-form';
import { consolePath } from '@/lib/console/paths';
import { getLeaseRepository, getRoomRepository, getTenantRepository } from '@/lib/repositories';

/**
 * ผลประเมินผู้เช่า (KS-15), as of a day — today unless `?date=` says
 * otherwise, so last month's sheet can be reprinted as it stood.
 *
 * Grades are edited on each tenant's profile; this page only reads them.
 */
const env = Astro.locals.runtime?.env;
const asOf = dateFromInput(Astro.url.searchParams.get('date') ?? '') ?? new Date();
const [rooms, leases, tenants] = await Promise.all([
  getRoomRepository(env).listRooms(),
  getLeaseRepository(env).listLeases(),
  getTenantRepository(env).listTenants(),
]);
const report = evaluationReportFor(rooms, leases, tenants, asOf);
const LINK =
  'inline-flex min-h-11 items-center text-base font-medium text-console-ink-soft no-underline hover:text-console-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-console-ink';
---

<ConsoleLayout title="ผลประเมินผู้เช่า">
  <main class="console-root mx-auto max-w-5xl px-4 py-6 print:max-w-none print:px-0 print:py-0">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3 print:hidden">
      <a href={consolePath('console/documents')} class={LINK}>← กลับไปเอกสาร</a>
      <form method="GET" class="flex flex-wrap items-center gap-2">
        <label class="text-[15px] text-console-ink-soft" for="date">ณ วันที่</label>
        <input id="date" name="date" type="date" value={dateToInput(asOf)}
          class="min-h-11 rounded-lg border-[1.5px] border-console-line-strong bg-console-card px-3" />
        <button type="submit" class="min-h-11 rounded-[10px] border-[1.5px] border-console-ink px-3 font-semibold text-console-ink">ดู</button>
        <button type="button" data-print
          class="min-h-11 rounded-[10px] bg-console-ink px-4 font-semibold text-white hover:bg-console-ink/90">
          พิมพ์ / บันทึกเป็น PDF
        </button>
      </form>
    </div>
    <p class="mb-3 text-sm text-console-ink-soft print:hidden">
      แก้เกรด อาชีพ และเบอร์โทรได้ที่โปรไฟล์ผู้เช่าแต่ละคน · จำนวนผู้พักมาจากสัญญาเช่า
    </p>
    <div class="overflow-hidden rounded-xl border border-console-line shadow-[0_8px_24px_rgba(30,45,74,0.08)] print:border-0 print:shadow-none">
      <EvaluationReport {report} />
    </div>
  </main>
</ConsoleLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
