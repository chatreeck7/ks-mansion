---
// src/pages/console/documents/print.astro
import BillSlips from '@/components/console/BillSlips.astro';
import PrintShell from '@/components/console/PrintShell.astro';
import CollectionSheet from '@/components/console/CollectionSheet.astro';
import EvaluationReport from '@/components/console/EvaluationReport.astro';
import ElectricitySummary from '@/components/console/ElectricitySummary.astro';
import MaintenanceGridSheet from '@/components/console/MaintenanceGridSheet.astro';
import MonthlyReportDocument from '@/components/console/MonthlyReportDocument.astro';
import MovementRegister from '@/components/console/MovementRegister.astro';
import RoomSummary from '@/components/console/RoomSummary.astro';
import { collectingCycle } from '@/lib/console/history';
import { maintenanceGrid } from '@/lib/console/maintenance-log';
import { electricitySummaryFor, roomSummaryFor } from '@/lib/console/month-summary';
import { movementPeriodFor, movementRegisterFor } from '@/lib/console/movements';
import { monthlyReportFor } from '@/lib/documents/monthly-report';
import { evaluationReportFor } from '@/lib/console/evaluation-report';
import { billBatchFor } from '@/lib/console/bill-batch';
import { collectionSheetFor } from '@/lib/console/collection-sheet';
import {
  documentTypesFor,
  selectedDocuments,
  selectionFrom,
} from '@/lib/console/document-types';
import { letterheadFrom, payeeFrom } from '@/lib/console/letterhead';
import { consolePath } from '@/lib/console/paths';
import { formatThaiDate } from '@/lib/format/thai';
import { cycleFromId, cycleLabel } from '@/lib/models/billing-cycle';
import {
  getBillRepository,
  getDocumentTemplateRepository,
  getLeaseRepository,
  getMaintenanceRepository,
  getMeterReadingRepository,
  getPaymentRepository,
  getRoomRepository,
  getSettingsRepository,
  getTenantRepository,
} from '@/lib/repositories';

/**
 * Every selected document, one file (KS-30, AC-4.5).
 *
 * **One page holding every section, printed once.** AC-4.5 asks for "one
 * combined PDF document containing every selected document type as its own
 * section/pages, not separate files per document type" — which is exactly
 * what a browser produces from this page via Save as PDF. The sections are
 * ordered by the registry, each starts on a fresh sheet, and a contents page
 * goes in front so a twenty-five page stack says what it is.
 *
 * **KS-24's note that this needed a real PDF engine was wrong**, and it is
 * worth saying why rather than quietly doing something else. An engine would
 * mean re-expressing every document as PDF primitives: a second copy of each
 * layout, drifting from the one an admin actually prints — the precise
 * problem `BillDocument.astro` was extracted to avoid — plus embedding and
 * shaping Thai text by hand. This composes the components that already exist
 * and adds only the page breaks between them.
 *
 * **The sections are switched on by id here, not resolved from the
 * registry.** A registry of data cannot hold Astro components, and pretending
 * otherwise would buy indirection rather than remove a copy. What the
 * registry does own is which documents exist, what they are called and which
 * are ready — so a type it does not mark ready can never reach this switch.
 */

const env = Astro.locals.runtime?.env;

const requested = Astro.url.searchParams.get('cycle');
const chosen = cycleFromId(requested);
const now = new Date();

// Everything is read once, up front: eight documents drawn from the same
// handful of tabs, and a read per section would spend the Sheets quota
// eight times over for one printout.
const maintenanceRepo = getMaintenanceRepository(env);
const [allBills, rooms, payments, leases, tenants, readings, reportBlocks, equipment, records, documentSettings] =
  await Promise.all([
    getBillRepository(env).listBills(),
    getRoomRepository(env).listRooms(),
    getPaymentRepository(env).listPayments(),
    getLeaseRepository(env).listLeases(),
    getTenantRepository(env).listTenants(),
    getMeterReadingRepository(env).listReadings(),
    getDocumentTemplateRepository(env).listBlocks('monthly_report'),
    maintenanceRepo.listEquipment(),
    maintenanceRepo.listRecords(),
    getSettingsRepository(env).resolveSettings(),
  ]);
const cycle = chosen ?? collectingCycle(allBills, now);

const types = documentTypesFor(cycle);
const raw = Astro.url.searchParams.has('include')
  ? Astro.url.searchParams.getAll('include').join(',')
  : null;
const sections = selectedDocuments(selectionFrom(raw, types), types);
const wants = (id: string) => sections.some((section) => section.id === id);

const bills = allBills.filter((bill) => bill.cycle === cycle.id && !bill.archived);
const batch = wants('bills') ? billBatchFor(cycle, bills, rooms, payments) : null;
const sheet = wants('collection') ? collectionSheetFor(cycle, bills, payments, rooms) : null;
// Not per cycle: the evaluation is the building as it stands today.
const evaluation = wants('evaluations') ? evaluationReportFor(rooms, leases, tenants, now) : null;
const report = wants('monthly_report')
  ? monthlyReportFor({ blocks: reportBlocks, cycle, settings: documentSettings, rooms, leases, readings, bills: allBills, payments, equipment, records, today: now })
  : null;
const electricity = wants('electricity') ? electricitySummaryFor(cycle, rooms, readings) : null;
const roomSummary = wants('rooms_summary') ? roomSummaryFor(cycle, rooms, leases, allBills) : null;
const movements = wants('movements') ? movementRegisterFor(movementPeriodFor(cycle), rooms, leases, tenants) : null;
const grid = wants('maintenance') ? maintenanceGrid(equipment, records, now) : null;

const letterhead = letterheadFrom(env, documentSettings);
const payee = payeeFrom(env, documentSettings);

/** How many sheets each section will take, for the contents page. */
function pagesIn(id: string): number {
  if (id === 'bills') return Math.ceil((batch?.documents.length ?? 0) / 2);
  return 1;
}
const landscape = (id: string) => id === 'maintenance' || id === 'collection';
/** The sheet each section starts on — named on the section itself, where both
 *  Paged.js (screen) and Chrome (print) switch sheets. */
const sheetClass = (id: string) => (landscape(id) ? 'paper-landscape' : id === 'bills' ? 'paper-half' : null);

const backToSelector = `${consolePath('console/documents')}?cycle=${cycle.id}` +
  sections.map((section) => `&include=${section.id}`).join('');
---

<PrintShell
  title={`เอกสารรวม ${cycleLabel(cycle)}`}
  building={letterhead.name}
  back={{ href: backToSelector, label: '← กลับไปเลือกเอกสาร' }}
  printLabel="พิมพ์ / บันทึกเป็น PDF ไฟล์เดียว"
>
  {sections.length === 0 ? (
    <p class="text-[15px]">ยังไม่ได้เลือกเอกสาร — เลือกที่หน้าเอกสารก่อน</p>
  ) : (
    <Fragment>
      {/* A contents page: the stack of paper says what it is and which month. */}
      <section>
        <header class="mb-6 border-b-2 border-console-print/50 pb-4">
          <p class="mb-1 text-lg font-semibold text-console-ink">{letterhead.name}</p>
          <h1 class="paper-title mb-1 text-2xl font-semibold text-console-ink">เอกสารประจำรอบ</h1>
          <p class="mb-0 text-console-ink-soft">{cycleLabel(cycle)} · พิมพ์เมื่อ {formatThaiDate(now)}</p>
        </header>
        <h2 class="mb-2 text-lg font-semibold text-console-ink">สารบัญ</h2>
        <ol class="mb-0 ps-5 text-console-ink">
          {sections.map((section) => (
            <li class="mb-1">
              <span class="font-semibold">{section.label}</span>
              <span class="text-console-ink-soft"> — {section.description}</span>
              <span class="ms-1 font-figure tabular-nums text-console-ink-faint">({pagesIn(section.id)} แผ่น)</span>
            </li>
          ))}
        </ol>
      </section>

      {sections.map((section) => (
        <section class:list={['paper-break', sheetClass(section.id)]}>
          {section.id === 'bills' &&
            (batch!.documents.length === 0 ? (
              <p class="paper-title mb-0">ยังไม่ได้ออกบิลรอบนี้</p>
            ) : (
              <BillSlips docs={batch!.documents} {letterhead} {payee} perPage={2} />
            ))}
          {section.id === 'collection' && <CollectionSheet sheet={sheet!} />}
          {section.id === 'evaluations' && <EvaluationReport report={evaluation!} />}
          {section.id === 'monthly_report' && <MonthlyReportDocument report={report!} />}
          {section.id === 'electricity' && <ElectricitySummary summary={electricity!} building={letterhead.name} />}
          {section.id === 'rooms_summary' && <RoomSummary summary={roomSummary!} building={letterhead.name} />}
          {section.id === 'movements' && <MovementRegister register={movements!} building={letterhead.name} />}
          {section.id === 'maintenance' && <MaintenanceGridSheet grid={grid!} dateLabel={`ณ ${formatThaiDate(now)}`} />}
        </section>
      ))}
    </Fragment>
  )}
</PrintShell>
