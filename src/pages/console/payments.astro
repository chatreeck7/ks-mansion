---
// src/pages/console/payments.astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import CyclePicker from '@/components/console/CyclePicker.astro';
import Button from '@/components/console/Button.astro';
import Card from '@/components/console/Card.astro';
import ErrorSummary from '@/components/console/ErrorSummary.astro';
import Notice from '@/components/console/Notice.astro';
import PageHeader from '@/components/console/PageHeader.astro';
import StatusPill from '@/components/console/StatusPill.astro';
import { viewedCycle } from '@/lib/console/history';
import { daysUntilDue } from '@/lib/console/logbook';
import { FOCUS, INPUT, SECTION_TITLE } from '@/lib/console/ui';
import { consolePath } from '@/lib/console/paths';
import {
  parsePaidOn,
  paymentRows,
  paymentsFromForm,
  toPaymentGroups,
} from '@/lib/console/payment-ledger';
import { formatBaht, formatThaiDate } from '@/lib/format/thai';
import { cycleLabel, cycleOptions } from '@/lib/models/billing-cycle';
import { paymentMethodLabel, type PaymentMethod } from '@/lib/models/payment';
import {
  getBillRepository,
  getPaymentRepository,
  getRoomRepository,
} from '@/lib/repositories';

/**
 * Recording what arrived (KS-23).
 *
 * The console does not take payments — reconciliation happens in LINE OA and
 * the bank app (NFR-1.3), and this screen is where the result of that gets
 * written down. So it asks for one date and one method for the whole
 * submission and an amount per room, which is the shape of the paper it
 * replaces: one sheet for the building, a column per day of the 26→10 window.
 *
 * Every recorded payment gets a receipt, and the list below the grid is how
 * you reach one after recording it.
 *
 * `?cycle=` opens an earlier cycle. Unlike ออกบิล, recording stays open
 * there: money for last month's bill arriving this month is ordinary — that is
 * what ยอดค้าง is — and a payment is filed against its bill, so it lands on
 * the right month whichever day it is written down.
 */

const env = Astro.locals.runtime?.env;

/** The day the screen is being used; also the default day money arrived. */
const today = new Date();
const viewed = viewedCycle(Astro.url.searchParams.get('cycle'), today);
const { cycle, past } = viewed;
const options = cycleOptions(today, cycle);

let errors: string[] = [];
let recorded = 0;
let collected = 0;
let submitted: FormData | undefined;
let paidOnValue = formatThaiDate(today);
let method: PaymentMethod = 'transfer';

async function load() {
  const [bills, payments, rooms] = await Promise.all([
    getBillRepository(env).listBillsForCycle(cycle.id),
    getPaymentRepository(env).listPayments(),
    getRoomRepository(env).listRooms(),
  ]);
  return { rows: paymentRows(bills, payments, rooms), payments };
}

if (Astro.request.method === 'POST') {
  submitted = await Astro.request.formData();
  method = submitted.get('method') === 'cash' ? 'cash' : 'transfer';

  const raw = submitted.get('paid_on');
  if (typeof raw === 'string' && raw.trim() !== '') paidOnValue = raw.trim();

  const { date, error } = parsePaidOn(raw, today);
  if (error) errors.push(error);

  if (date) {
    // Re-planned from a fresh read rather than from the rendered page: a
    // payment recorded in another tab must change what is still outstanding.
    const { rows } = await load();
    const submission = paymentsFromForm(rows, submitted, date, method);
    errors.push(...submission.errors);

    const repository = getPaymentRepository(env);
    for (const draft of submission.drafts) {
      try {
        await repository.recordPayment(draft);
        recorded += 1;
        collected += draft.amount;
      } catch (cause) {
        // Per row, not aborting: payments are append-only, so the ones
        // already written are complete and correct on their own.
        errors.push(`${draft.billId}: ${cause instanceof Error ? cause.message : String(cause)}`);
      }
    }
  }
}

// Reloaded after writing, so every row shows what it now stands at.
const { rows, payments } = await load();
// Keep what was typed only while something is still wrong; a clean save shows
// the sheet's own figures back.
const groups = toPaymentGroups(rows, cycleLabel(cycle), errors.length > 0 ? submitted : undefined);

const billIds = new Set(rows.map((row) => row.bill.id));
const roomOf = new Map(rows.map((row) => [row.bill.id, row.roomLabel]));
// Newest first: the receipt you want is almost always the one you just made.
const thisCycle = payments
  .filter((payment) => billIds.has(payment.billId))
  .sort((a, b) => b.paidOn.getTime() - a.paidOn.getTime());

const ledger = groups[0]?.rows ?? [];
const lines = rows.map((row, i) => {
  const cells = ledger[i]!.cells;
  return {
    ...row,
    amount: cells.amount as { name: string; value: string; label: string; placeholder?: string },
    note: cells.note as { name: string; value: string; label: string; placeholder?: string },
    state: cells.state as { tone: 'ok' | 'warn' | 'crit' | 'info' | 'mute'; label: string },
  };
});
// Still owing first; settled rooms drop to the card beside the list.
const owing = lines.filter((l) => l.settlement.outstanding > 0);
const settled = lines.filter((l) => l.settlement.outstanding <= 0);
const billed = rows.reduce((sum, row) => sum + row.settlement.due, 0);
const collectedTotal = rows.reduce((sum, row) => sum + row.settlement.paid, 0);
const paidPct = billed > 0 ? Math.min(100, Math.round((collectedTotal / billed) * 100)) : 0;
const days = daysUntilDue(cycle, today);
const lastPaid = (row: (typeof lines)[number]) => row.settlement.payments.at(-1)?.paidOn;

const outstanding = rows.reduce(
  (sum, row) => sum + Math.max(row.settlement.outstanding, 0),
  0,
);
---

<ConsoleFrame title="รับเงิน" activeSection="payments">
  <PageHeader
    eyebrow="ขั้น 4 จาก 6"
    title="บันทึกเงินเข้า"
    subtitle={`ตรวจสลิปใน LINE OA ก่อน แล้วค่อยบันทึกที่นี่ · ${cycleLabel(cycle)}`}
  >
    <CyclePicker slot="actions" {options} selected={cycle} />
  </PageHeader>

  {viewed.problem && <Notice tone="warn">{viewed.problem}</Notice>}
  {past && (
    <Notice tone="info">รอบย้อนหลัง — ยังบันทึกเงินที่มาจ่ายช้าได้ เงินจะเข้าบิลของรอบนี้ ไม่ใช่รอบปัจจุบัน</Notice>
  )}

  {recorded > 0 && (
    <Notice tone="ok" role="status">
      บันทึกแล้ว {recorded} รายการ รวม {formatBaht(collected)} บาท — ออกใบเสร็จได้ที่รายการด้านล่าง
    </Notice>
  )}
  <ErrorSummary message={errors.length > 0 ? errors.join('\n') : null} />

  {rows.length > 0 && (
    <p class="-mt-3 mb-4 text-base text-console-ink-soft desk:hidden">
      รับแล้ว {settled.length}/{rows.length} · ค้าง <span class="font-figure font-semibold text-console-ink">{formatBaht(outstanding)}</span>
    </p>
  )}
  {rows.length === 0 && (
    <Notice tone="warn">{past ? 'รอบนี้ไม่ได้ออกบิลไว้ — ไม่มีอะไรให้บันทึก' : 'ยังไม่มีบิลของรอบนี้ — ออกบิลก่อนจึงจะบันทึกการรับเงินได้'}</Notice>
  )}

  <div class="flex flex-col gap-6 desk:flex-row desk:items-start">
    <form method="POST" class="min-w-0 flex-1" data-payments>
      <fieldset class="mb-4 flex flex-wrap items-end gap-3 border-0 p-0 desk:gap-5">
        <label class="flex flex-1 flex-col gap-1 text-[15px] font-medium text-console-ink-soft desk:flex-none">
          วันที่รับ
          <input
            type="text"
            name="paid_on"
            value={paidOnValue}
            class:list={[INPUT, 'font-semibold desk:w-48']}
          />
        </label>

        <div class="flex flex-col gap-1 text-[15px] font-medium text-console-ink-soft">
          <span id="method-label">ช่องทาง</span>
          <div role="radiogroup" aria-labelledby="method-label" class="flex overflow-hidden rounded-lg border-[1.5px] border-console-ink">
            {(['transfer', 'cash'] as const).map((value) => (
              <label class="relative cursor-pointer">
                <input type="radio" name="method" value={value} checked={method === value} class="peer sr-only" />
                <span class="flex min-h-11 items-center px-4 font-semibold text-console-ink peer-checked:bg-console-ink peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:-outline-offset-4 peer-focus-visible:outline-console-highlight">
                  {paymentMethodLabel(value)}
                </span>
              </label>
            ))}
          </div>
        </div>
      </fieldset>

      <h2 class={SECTION_TITLE}>ยังไม่จ่าย ({owing.length})</h2>
      {owing.length === 0 && rows.length > 0 && (
        <p class="mb-4 border-t-2 border-console-ink py-3 text-[15px] text-console-ok">✓ รับครบทุกห้องแล้ว</p>
      )}
      {owing.length > 0 && (
        <ul class="m-0 flex list-none flex-col gap-2 p-0 desk:gap-0 desk:border-t-2 desk:border-console-ink">
          {owing.map((line) => (
            <li
              data-payment-row
              class="flex flex-col gap-2 rounded-xl border border-console-line bg-console-card p-3 desk:grid desk:grid-cols-[64px_minmax(0,1fr)_150px_96px_minmax(0,1fr)] desk:items-center desk:gap-2.5 desk:rounded-none desk:border-0 desk:border-b desk:border-console-rule desk:bg-transparent desk:px-2 desk:py-1.5"
            >
              <div class="flex items-baseline gap-2 desk:contents">
                <span class="font-hand text-xl font-semibold desk:text-[17px]">{line.roomLabel}</span>
                <span class="flex-1 text-[15px] text-console-ink-soft">
                  {line.settlement.paid > 0 ? `จ่ายแล้ว ${formatBaht(line.settlement.paid)} · ` : ''}ค้าง{' '}
                  <span class="font-figure font-semibold text-console-ink" data-outstanding={line.settlement.outstanding}>
                    {formatBaht(line.settlement.outstanding)}
                  </span>
                </span>
              </div>
              <div class="flex gap-2 desk:contents">
              <label class="flex-1">
                <span class="sr-only">{line.amount.label}</span>
                <input
                  type="text"
                  inputmode="decimal"
                  name={line.amount.name}
                  value={line.amount.value}
                  placeholder={line.amount.placeholder}
                  data-amount
                  class:list={[INPUT, 'text-right font-figure tabular-nums']}
                />
              </label>
              <button
                type="button"
                data-fill
                class:list={[
                  'min-h-11 w-24 flex-none rounded-lg bg-console-ok px-3 text-[15px] font-semibold text-white hover:bg-console-ok/90 desk:w-auto',
                  FOCUS,
                ]}
              >
                รับครบ
              </button>
              </div>
              <label>
                <span class="sr-only">{line.note.label}</span>
                <input
                  type="text"
                  name={line.note.name}
                  value={line.note.value}
                  placeholder={line.note.placeholder}
                  class:list={[INPUT, 'text-[15px]']}
                />
              </label>
            </li>
          ))}
        </ul>
      )}

      {rows.length > 0 && (
        <div class="sticky bottom-16 -mx-4 mt-4 flex flex-col gap-2 border-t border-console-line bg-console-paper px-4 py-3 desk:static desk:mx-0 desk:flex-row desk:items-center desk:justify-between desk:border-0 desk:bg-transparent desk:p-0">
          <p class="text-[15px] text-console-ink-soft">
            กรอกเฉพาะห้องที่เงินเข้าแล้ว · จ่ายบางส่วนหรือเกินยอดได้
          </p>
          <Button type="submit" size="lg">บันทึกเงินเข้า</Button>
        </div>
      )}
    </form>

    <aside class="flex w-full flex-col gap-3.5 desk:w-[270px] desk:flex-none">
      <Card class="flex flex-col gap-2">
        <h2 class="font-hand text-[17px] font-semibold">{past ? 'รอบที่เลือก' : 'รอบนี้'}</h2>
        <div class="flex justify-between text-[15px]">
          <span class="text-console-ink-soft">ยอดบิลทั้งหมด</span><span class="font-figure">{formatBaht(billed)}</span>
        </div>
        <div class="flex justify-between text-[15px] text-console-ok">
          <span>รับแล้ว ✓</span><span class="font-figure">{formatBaht(collectedTotal)}</span>
        </div>
        <div class="flex justify-between border-t border-console-rule pt-2 text-base font-semibold">
          <span>ยังค้าง</span><span class="font-figure">{formatBaht(outstanding)}</span>
        </div>
        <div class="h-2.5 overflow-hidden rounded-full bg-console-sunk" role="img" aria-label={`รับแล้ว ${paidPct}%`}>
          <div class="h-full bg-console-ok" style={`width:${paidPct}%`}></div>
        </div>
        <span class="text-sm text-console-ink-soft">
          ครบกำหนด {formatThaiDate(cycle.dueDate)} · {days >= 0 ? `อีก ${days} วัน` : `เลยมา ${-days} วัน`}
        </span>
      </Card>

      {settled.length > 0 && (
        <Card tone="spine" class="flex flex-col gap-1">
          <h2 class="font-hand text-base font-semibold text-console-ok">จ่ายแล้ว ✓ {settled.length}</h2>
          {settled.map((line) => (
            <div class="flex justify-between gap-2 text-sm text-console-ink-soft">
              <span>{line.roomLabel}</span>
              <span>
                {lastPaid(line) ? formatThaiDate(lastPaid(line)!) : ''}
                {line.settlement.state === 'overpaid' && (
                  <StatusPill tone={line.state.tone} label={line.state.label} />
                )}
              </span>
            </div>
          ))}
        </Card>
      )}

      {thisCycle.length > 0 && (
        <Card class="flex flex-col gap-1">
          <h2 class="font-hand text-base font-semibold">ใบเสร็จรอบนี้</h2>
          <ul class="m-0 list-none p-0">
            {thisCycle.map((payment) => (
              <li class="border-b border-dotted border-console-line-strong last:border-0">
                <a
                  href={consolePath(`console/receipts/${payment.id}`)}
                  class:list={['flex min-h-10 items-center justify-between gap-2 text-sm text-console-ink no-underline hover:underline', FOCUS]}
                >
                  <span class="font-hand font-semibold">{roomOf.get(payment.billId) ?? payment.billId}</span>
                  <span class="text-console-ink-soft">{formatThaiDate(payment.paidOn)} · {paymentMethodLabel(payment.method)}</span>
                  <span class="font-figure">{formatBaht(payment.amount)}</span>
                </a>
              </li>
            ))}
          </ul>
        </Card>
      )}
    </aside>
  </div>
</ConsoleFrame>

<script>
  // "รับครบ" writes the outstanding amount into the row's field — one tap
  // instead of copying a figure. The amount stays visible in the field and
  // nothing is recorded until the form is submitted, so it is still the
  // admin's decision; without script the field is typed as before.
  for (const row of document.querySelectorAll<HTMLElement>('[data-payment-row]')) {
    const amount = row.querySelector<HTMLInputElement>('[data-amount]');
    const owed = row.querySelector<HTMLElement>('[data-outstanding]')?.dataset.outstanding;
    row.querySelector('[data-fill]')?.addEventListener('click', () => {
      if (!amount || !owed) return;
      amount.value = owed;
      amount.focus();
    });
  }
</script>
