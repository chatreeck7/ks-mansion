---
// src/pages/console/collection.astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import CollectionSheet from '@/components/console/CollectionSheet.astro';
import CyclePicker from '@/components/console/CyclePicker.astro';
import { collectionSheetFor } from '@/lib/console/collection-sheet';
import { consolePath } from '@/lib/console/paths';
import { formatBaht } from '@/lib/format/thai';
import { cycleFor, cycleFromId, cycleOptions } from '@/lib/models/billing-cycle';
import { getBillRepository, getPaymentRepository, getRoomRepository } from '@/lib/repositories';

/**
 * แบบฟอร์มเก็บเงินค่าห้อง (KS-25).
 *
 * **Drawn as the paper, not as a console table.** Every cell ruled, the
 * form's own header line across the top, a รวม row at the foot — because
 * this is a document that gets printed and carried round the building, and
 * an admin reading across a row is reading by position. It is rendered here
 * rather than through `LedgerTable` for the same reason the bill is: the
 * ledger is the console's house style for screens you *read*, and this is a
 * form you *fill in*.
 *
 * What prints is what is on screen. The frame hides its own chrome under
 * print, so the preview and the paper are the same thing — no separate
 * export route to drift from the page.
 */

const env = Astro.locals.runtime?.env;

const now = new Date();
const requested = Astro.url.searchParams.get('cycle');
const chosen = cycleFromId(requested);
// A typed or stale `?cycle=` says so rather than quietly showing a different
// month than the one in the address bar.
const unknownCycle = requested !== null && chosen === null;
const cycle = chosen ?? cycleFor(now);
const options = cycleOptions(now, chosen);

const [bills, payments, rooms] = await Promise.all([
  getBillRepository(env).listBillsForCycle(cycle.id),
  getPaymentRepository(env).listPayments(),
  getRoomRepository(env).listRooms(),
]);

const sheet = collectionSheetFor(cycle, bills, payments, rooms);
const billedRows = sheet.rows.filter((row) => row.bill !== null).length;
const unpaid = sheet.rows.filter(
  (row) => row.settlement !== null && row.settlement.paid === 0,
).length;

---

<ConsoleFrame title="แบบฟอร์มเก็บเงินค่าห้อง" activeSection="collection">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3 print:hidden">
    <div>
      <h1 class="mb-1 text-xl font-semibold text-console-ink">ใบเก็บเงิน</h1>
      <p class="mb-0 text-sm text-console-ink-soft">
        ช่องว่างคือยังไม่ได้รับเงิน · บันทึกการรับเงินที่หน้า{' '}
        <a
          href={consolePath('console/payments')}
          class="underline underline-offset-2 hover:no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
          >รับเงิน</a
        >{' '}· เขียนหมายเหตุค้างที่หน้า{' '}
        <a
          href={consolePath('console/bills')}
          class="underline underline-offset-2 hover:no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
          >บิล</a
        >
      </p>
    </div>

    <div class="flex flex-wrap items-end gap-2">
      <CyclePicker {options} selected={cycle} />
      <button
        type="button"
        data-print
        class="rounded-sm border border-console-rule/40 px-3 py-2 text-sm text-console-ink hover:bg-console-sunk focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
      >
        พิมพ์ / บันทึกเป็น PDF
      </button>
    </div>
  </div>

  {unknownCycle && (
    <p class="mb-4 rounded-sm bg-console-warn-bg px-3 py-2 text-sm text-console-warn print:hidden">
      ไม่รู้จักรอบ "{requested}" — แสดงรอบปัจจุบันแทน
    </p>
  )}

  {/* An unbilled month renders a grid with every ค่าห้องฯ blank, which is
      the correct sheet and reads exactly like a broken page — the month
      changed, the table did not, because there was nothing in it either
      way. Said plainly, with the way to fix it, and hidden from print: a
      blank form is still worth carrying round and filling in by hand. */}
  {billedRows === 0 && (
    <p class="mb-3 rounded-sm bg-console-warn-bg px-3 py-2 text-sm text-console-warn print:hidden">
      ยังไม่ได้ออกบิลรอบนี้ — ช่อง ค่าห้องฯ จึงว่างทั้งแผ่น ออกบิลที่หน้า{' '}
      <a
        href={consolePath('console/bills')}
        class="underline underline-offset-2 hover:no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
        >บิล</a
      >{' '}แล้วกลับมาดูอีกครั้ง
    </p>
  )}

  <CollectionSheet {sheet} />

  <div class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-sm print:hidden">
    <p class="mb-0 text-console-ink-soft">
      รับแล้ว{' '}
      <span class="font-figure font-semibold tabular-nums text-console-ok">
        {formatBaht(sheet.collected)}
      </span>{' '}บาท
    </p>
    <p class="mb-0 text-console-ink-soft">
      คงเหลือ{' '}
      <span
        class:list={[
          'font-figure font-semibold tabular-nums',
          sheet.outstanding > 0 ? 'text-console-warn' : 'text-console-ink',
        ]}
      >
        {formatBaht(sheet.outstanding)}
      </span>{' '}บาท
    </p>
    {unpaid > 0 && <p class="mb-0 text-console-warn">ยังไม่ได้จ่ายเลย {unpaid} ห้อง</p>}
  </div>
</ConsoleFrame>

<script>
  // Progressive enhancement only: Ctrl-P prints the same thing.
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
