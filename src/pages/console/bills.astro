---
// src/pages/console/bills.astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import CyclePicker from '@/components/console/CyclePicker.astro';
import Button from '@/components/console/Button.astro';
import ErrorSummary from '@/components/console/ErrorSummary.astro';
import Notice from '@/components/console/Notice.astro';
import PageHeader from '@/components/console/PageHeader.astro';
import ProblemCard from '@/components/console/ProblemCard.astro';
import StatTile from '@/components/console/StatTile.astro';
import { problemGroups } from '@/lib/console/problems';
import { LINK, SECTION_TITLE } from '@/lib/console/ui';
import BillLedger from '@/components/console/BillLedger.astro';
import { arrearsUpdatesFromForm } from '@/lib/console/arrears';
import { rowsFromIssued, rowsFromRun } from '@/lib/console/bill-ledger';
import { billRunSections, draftsFrom, planBillRun } from '@/lib/console/bill-run';
import { issuedLines, viewedCycle } from '@/lib/console/history';
import { inReissueWindow } from '@/lib/console/bill-reissue';
import { consolePath } from '@/lib/console/paths';
import { formatBaht } from '@/lib/format/thai';
import { billTotal } from '@/lib/models/bill';
import { cycleLabel, cycleOptions, rentLabel, utilityLabel } from '@/lib/models/billing-cycle';
import {
  getBillRepository,
  getLeaseRepository,
  getMeterReadingRepository,
  getRoomRepository,
} from '@/lib/repositories';

/**
 * Issue a cycle's bills (KS-21).
 *
 * **The whole cycle at once, behind a preview** — owner's call, and it
 * matches the paper it replaces: แบบฟอร์มเก็บเงินค่าห้อง is one sheet for the
 * whole building, not 27 slips. The preview shows the working rather than
 * only the amounts, because the ค่าไฟ row of the real bill prints previous
 * reading, current reading, units and rate, and a screen that showed less
 * would be harder to check than the form it replaces.
 *
 * Nothing is written until the button is pressed, and the plan is recomputed
 * on POST from fresh reads — so what gets issued is what the sheet supports at
 * that moment, not what the page happened to show a minute ago.
 *
 * **Earlier cycles are read, not issued.** `?cycle=` opens a past month to
 * look at what went out — the bills as they were issued, their documents and
 * their notes — but the issue action exists only for the cycle you are in.
 * A past month is shown from its bills rather than re-planned: a plan works
 * from today's rooms and rates, and would restate what was charged.
 */

const env = Astro.locals.runtime?.env;

let issued = 0;
let annotated = 0;
let errors: string[] = [];
let submittedNotes: FormData | undefined;

// Issuing always belongs to the cycle you are in — letting someone issue
// into another invites billing a closed month by accident. Other cycles can
// be *opened* to look back at, which is what `past` gates below.
const now = new Date();
const viewed = viewedCycle(Astro.url.searchParams.get('cycle'), now);
const { cycle, past } = viewed;
const options = cycleOptions(now, cycle);

async function load() {
  const [rooms, leases, readings, existing] = await Promise.all([
    getRoomRepository(env).listRooms(),
    getLeaseRepository(env).listLeases(),
    getMeterReadingRepository(env).listReadings(),
    getBillRepository(env).listBills(),
  ]);
  return planBillRun({ cycle, rooms, leases, readings, existing });
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const bills = getBillRepository(env);

  // Two actions on one page, told apart by a hidden field rather than by
  // which fields happen to be present — issuing a cycle and annotating one
  // are different enough that guessing between them would eventually guess
  // wrong, and one of the two writes money figures.
  if (form.get('action') === 'annotate') {
    submittedNotes = form;
    const existing = (await bills.listBills()).filter((bill) => bill.cycle === cycle.id);

    for (const update of arrearsUpdatesFromForm(existing, form)) {
      try {
        await bills.annotateArrears(update.billId, update.note);
        annotated += 1;
      } catch (cause) {
        errors.push(`${update.billId}: ${cause instanceof Error ? cause.message : String(cause)}`);
      }
    }
  } else if (past) {
    // The page never offers this, so it is a stale tab or a hand-made POST —
    // refused here rather than trusted to the missing button.
    errors.push('ออกบิลย้อนหลังไม่ได้ — ออกบิลได้เฉพาะรอบปัจจุบัน');
  } else {
    // Re-planned from a fresh read rather than trusting the rendered page: a
    // reading corrected in another tab must change what is issued.
    for (const draft of draftsFrom(await load())) {
      try {
        await bills.issueBill(draft);
        issued += 1;
      } catch (cause) {
        // Per room, not aborting: bills are append-only, so the ones already
        // written are complete and correct on their own.
        errors.push(`${draft.roomId}: ${cause instanceof Error ? cause.message : String(cause)}`);
      }
    }
  }
}

// Reloaded after writing, so every room that just landed shows as ออกแล้ว
// and every note that just saved shows in its field.
const issuedBills = await getBillRepository(env).listBillsForCycle(cycle.id);
// A past cycle is never planned — see the note at the top.
const run = past ? null : await load();
const allRooms = await getRoomRepository(env).listRooms();
const roomLabelOf = new Map(allRooms.map((room) => [room.id, room.label]));
// Cancelled bills (ยกเลิกบิล on a bill's page) whose room has nothing in
// their place yet, while the cycle can still be reissued.
const awaitingReissue = inReissueWindow(cycle.id, now)
  ? (await getBillRepository(env).listVoidedBillsForCycle(cycle.id)).filter(
      (voided) => !issuedBills.some((bill) => bill.roomId === voided.roomId),
    )
  : [];
// What still needs the admin comes first; issued bills fold away while
// there is anything left to do (found on the live console: two rooms that
// mattered were buried in a 24-row table of finished ones).
const sections = run ? billRunSections(run.lines) : null;
const workLeft = sections ? sections.todo.length > 0 : false;
const blocked = run ? run.lines.filter((l) => l.problems.length > 0 && !l.alreadyIssued).length : 0;
const problems = run ? problemGroups(run.lines) : [];
const issuedCount = run ? run.lines.filter((l) => l.alreadyIssued).length : issuedBills.length;
const issuedTotal = issuedBills.reduce((sum, bill) => sum + billTotal(bill), 0);
// Re-fill typed notes only while something is still wrong; a clean save
// shows what the sheet now holds.
const typed = errors.length > 0 ? submittedNotes : undefined;
const openGroups = sections
  ? [
      ...(sections.todo.length > 0 ? [{ label: 'ต้องทำ', rows: rowsFromRun(sections.todo, typed) }] : []),
      ...(sections.nothingDue.length > 0 ? [{ label: 'ไม่มียอดรอบนี้', rows: rowsFromRun(sections.nothingDue, typed) }] : []),
    ]
  : [];
const issuedGroups = sections
  ? sections.issued.length > 0
    ? [{ label: 'ออกบิลแล้ว', rows: rowsFromRun(sections.issued, typed) }]
    : []
  : [{ label: cycleLabel(cycle), rows: rowsFromIssued(issuedLines(issuedBills, allRooms), typed) }];
---

<ConsoleFrame title="ออกบิล" activeSection="bills">
  <PageHeader
    eyebrow="ขั้น 3 จาก 6"
    title={past ? 'บิลที่ออกไปแล้ว' : 'ออกบิลประจำรอบ'}
    subtitle={`${rentLabel(cycle)} + ${utilityLabel(cycle)} · ${cycleLabel(cycle)}`}
  >
    <CyclePicker slot="actions" {options} selected={cycle} />
  </PageHeader>

  {viewed.problem && <Notice tone="warn">{viewed.problem}</Notice>}
  {past && (
    <Notice tone="info">รอบย้อนหลัง — ดูได้อย่างเดียว ออกบิลได้เฉพาะ<a href={consolePath('console/bills')} class={LINK}>รอบปัจจุบัน</a></Notice>
  )}

  {issued > 0 && <Notice tone="ok" role="status">ออกบิลแล้ว {issued} ใบ</Notice>}
  {awaitingReissue.length > 0 && (
    <Notice tone="warn">
      บิลที่ยกเลิกแล้ว ยังไม่ได้ออกใหม่:{' '}
      {awaitingReissue.map((voided, i) => (
        <Fragment>
          {i > 0 && ' · '}
          <a href={consolePath(`console/bills/${voided.id}`)} class={LINK}>ห้อง {roomLabelOf.get(voided.roomId) ?? voided.roomId} ({voided.id})</a>
        </Fragment>
      ))}
      {' '}— เปิดบิลแล้วกด <strong>ออกบิลใหม่</strong>
    </Notice>
  )}
  {annotated > 0 && <Notice tone="ok" role="status">บันทึกหมายเหตุแล้ว {annotated} รายการ</Notice>}
  <ErrorSummary message={errors.length > 0 ? errors.join('\n') : null} />

  {run && (
    <div class="mb-4 grid grid-cols-3 gap-1.5 desk:gap-3.5">
      <StatTile mark="done" count={issuedCount} label="ออกบิลแล้ว" />
      <StatTile mark="todo" count={run.issuable.length} label="พร้อมออก" />
      <StatTile mark={blocked > 0 ? 'missing' : 'none'} count={blocked} label="รอข้อมูล" />
    </div>
  )}

  {/* Blocked rooms, one card per reason with one fix — never a row each. */}
  {problems.length > 0 && (
    <div class="mb-5 flex flex-col gap-3">
      {problems.map((problem) => (
        <ProblemCard
          layout="row"
          title={problem.title}
          items={problem.rooms.map((r) => ({ label: r.label, href: r.href }))}
          action={problem.action}
        />
      ))}
    </div>
  )}

  {/* The action bar: issue, print, move on. Above the ledger so it is the
      first thing after what is blocking, and sticky on a phone. */}
  <div class="sticky bottom-16 z-10 -mx-4 mb-4 flex flex-col gap-2 border-y border-console-line bg-console-paper/95 px-4 py-3 backdrop-blur desk:static desk:mx-0 desk:flex-row desk:flex-wrap desk:items-center desk:border-0 desk:bg-transparent desk:p-0">
    {!run ? (
      <Notice tone="mute" flush class="desk:flex-1">
        {issuedBills.length === 0 ? 'รอบนี้ไม่ได้ออกบิลไว้' : `ออกไป ${issuedBills.length} ใบ รวม ${formatBaht(issuedTotal)} บาท`}
      </Notice>
    ) : run.issuable.length === 0 ? (
      <Notice tone="mute" flush class="desk:flex-1">
        {run.lines.length === 0
          ? 'ยังไม่มีห้องที่ต้องออกบิลรอบนี้'
          : run.lines.every((line) => line.alreadyIssued || line.nothingDue)
            ? 'ออกบิลครบทุกห้องแล้วสำหรับรอบนี้'
            : 'ยังออกบิลไม่ได้ — แก้ตามการ์ดสีแดงด้านบนก่อน'}
      </Notice>
    ) : (
      <form
        method="POST"
        class="flex items-center gap-3"
        data-confirm={[
          `ออกบิล ${run.issuable.length} ห้อง รวม ${formatBaht(run.total)} บาท ของ${cycleLabel(cycle)}`,
          blocked > 0 ? `อีก ${blocked} ห้องยังติดปัญหา จะยังไม่ออกบิลรอบนี้` : '',
          'ออกแล้วเลขมิเตอร์ของห้องเหล่านี้จะแก้ไม่ได้ — ตรวจตัวเลขในตารางก่อน',
        ].filter(Boolean).join(' · ')}
        data-confirm-title={`ยืนยันออกบิล ${run.issuable.length} ใบ`}
        data-confirm-label="ยืนยัน ออกบิล"
        data-confirm-cancel="กลับไปตรวจ"
      >
        <input type="hidden" name="action" value="issue" />
        <Button type="submit" size="lg">ออกบิล {run.issuable.length} ใบ</Button>
        <span class="font-figure text-[15px] tabular-nums text-console-ink-soft">
          รวม <span class="font-semibold text-console-ink">{formatBaht(run.total)}</span> บาท
        </span>
      </form>
    )}
    {issuedBills.length > 0 && (
      <div class="flex flex-wrap gap-2 desk:ms-auto">
        <Button href={`${consolePath('console/bills/print')}?cycle=${cycle.id}`} variant="secondary" size="lg">
          พิมพ์ใบแจ้ง ({issuedBills.length})
        </Button>
        <Button
          href={past ? `${consolePath('console/payments')}?cycle=${cycle.id}` : consolePath('console/payments')}
          variant="secondary"
          size="lg"
        >
          {past ? 'ดูการรับเงิน →' : 'ไปขั้น 4 รับเงิน →'}
        </Button>
      </div>
    )}
  </div>

  {/* One form for the notes: หมายเหตุ / ยอดค้าง sits in each issued bill's
      row. Written by hand — the console does not work out arrears
      (ยอดค้าง and ค้างประกัน are different things only a person can tell). */}
  <form method="POST" data-notes-form>
    <input type="hidden" name="action" value="annotate" />
    {openGroups.length > 0 && <BillLedger groups={openGroups} />}
    {issuedGroups.length > 0 && (
      run && workLeft ? (
        <details class="mt-4">
          <summary class="flex min-h-11 cursor-pointer items-center gap-2 text-[15px] font-semibold text-console-ink">
            ออกบิลแล้ว {issuedGroups[0]!.rows.length} ใบ · รวม {formatBaht(issuedTotal)} บาท
            <span class="text-sm font-normal text-console-ink-soft">(กดเพื่อดูและใส่หมายเหตุ)</span>
          </summary>
          <BillLedger groups={issuedGroups} />
        </details>
      ) : (
        <div class="mt-2"><BillLedger groups={issuedGroups} /></div>
      )
    )}
    <div class="sticky bottom-16 z-10 mt-3 hidden items-center gap-3 rounded-xl border border-console-ink bg-console-card px-4 py-2 shadow-[0_8px_24px_rgba(30,45,74,0.12)] desk:bottom-4" data-notes-bar>
      <span class="flex-1 text-[15px] text-console-ink" data-notes-count>แก้หมายเหตุแล้ว</span>
      <Button type="submit" size="md">บันทึกหมายเหตุ</Button>
    </div>
  </form>
</ConsoleFrame>

<script>
  // Show "บันทึกหมายเหตุ" only once a note has actually changed, with how many.
  const form = document.querySelector<HTMLFormElement>('[data-notes-form]');
  const bar = form?.querySelector<HTMLElement>('[data-notes-bar]');
  const count = form?.querySelector<HTMLElement>('[data-notes-count]');
  form?.addEventListener('input', () => {
    const changed = [...form.querySelectorAll<HTMLInputElement>('[data-note-input]')].filter(
      (input) => input.value.trim() !== (input.dataset.original ?? '').trim(),
    ).length;
    if (bar) bar.style.display = changed > 0 ? 'flex' : 'none';
    if (count) count.textContent = `แก้หมายเหตุ ${changed} ห้อง — ยังไม่ได้บันทึก`;
  });
</script>
