---
// src/pages/console/bills.astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import CyclePicker from '@/components/console/CyclePicker.astro';
import Button from '@/components/console/Button.astro';
import ErrorSummary from '@/components/console/ErrorSummary.astro';
import Notice from '@/components/console/Notice.astro';
import PageHeader from '@/components/console/PageHeader.astro';
import ProblemCard from '@/components/console/ProblemCard.astro';
import StatTile from '@/components/console/StatTile.astro';
import { problemGroups } from '@/lib/console/problems';
import { LINK, SECTION_TITLE } from '@/lib/console/ui';
import LedgerTable from '@/components/console/LedgerTable.astro';
import {
  ARREARS_COLUMNS,
  arrearsUpdatesFromForm,
  toArrearsGroups,
} from '@/lib/console/arrears';
import { billRunSections, draftsFrom, planBillRun, type BillLine } from '@/lib/console/bill-run';
import { issuedLines, viewedCycle, type IssuedLine } from '@/lib/console/history';
import { consolePath } from '@/lib/console/paths';
import { formatBaht } from '@/lib/format/thai';
import { billTotal } from '@/lib/models/bill';
import { cycleLabel, cycleOptions, rentLabel, utilityLabel } from '@/lib/models/billing-cycle';
import type { LedgerColumn, LedgerGroup } from '@/lib/models/ledger';
import {
  getBillRepository,
  getLeaseRepository,
  getMeterReadingRepository,
  getRoomRepository,
} from '@/lib/repositories';

/**
 * Issue a cycle's bills (KS-21).
 *
 * **The whole cycle at once, behind a preview** — owner's call, and it
 * matches the paper it replaces: แบบฟอร์มเก็บเงินค่าห้อง is one sheet for the
 * whole building, not 27 slips. The preview shows the working rather than
 * only the amounts, because the ค่าไฟ row of the real bill prints previous
 * reading, current reading, units and rate, and a screen that showed less
 * would be harder to check than the form it replaces.
 *
 * Nothing is written until the button is pressed, and the plan is recomputed
 * on POST from fresh reads — so what gets issued is what the sheet supports at
 * that moment, not what the page happened to show a minute ago.
 *
 * **Earlier cycles are read, not issued.** `?cycle=` opens a past month to
 * look at what went out — the bills as they were issued, their documents and
 * their notes — but the issue action exists only for the cycle you are in.
 * A past month is shown from its bills rather than re-planned: a plan works
 * from today's rooms and rates, and would restate what was charged.
 */

const env = Astro.locals.runtime?.env;

const COLUMNS: LedgerColumn[] = [
  { key: 'room', header: 'ห้อง' },
  { key: 'rent', header: 'ค่าเช่า', align: 'right' },
  { key: 'electricity', header: 'ค่าไฟ', align: 'right' },
  { key: 'working', header: 'คิดจาก' },
  { key: 'water', header: 'ค่าน้ำ', align: 'right' },
  { key: 'total', header: 'รวม', align: 'right' },
  { key: 'state', header: 'สถานะ' },
  { key: 'document', header: 'ใบแจ้ง' },
];

/** A past cycle: every row was issued, and its figures are the bill's own. */
function toIssuedGroups(lines: IssuedLine[], label: string): LedgerGroup[] {
  return [
    {
      label,
      rows: lines.map((line) => ({
        id: line.bill.id,
        cells: {
          room: { kind: 'text', value: line.roomLabel },
          rent: { kind: 'figure', value: line.bill.rentAmount },
          electricity: { kind: 'figure', value: line.bill.electricityAmount },
          working: { kind: 'text', value: line.electricityBasis, muted: true },
          water: { kind: 'figure', value: line.bill.waterAmount },
          total: { kind: 'figure', value: line.total },
          state: { kind: 'pill', tone: 'mute', label: 'ออกแล้ว' },
          document: {
            kind: 'link',
            href: consolePath(`console/bills/${line.bill.id}`),
            label: 'เปิด / พิมพ์',
          },
        },
      })),
    },
  ];
}

function toGroups(lines: BillLine[], label: string): LedgerGroup[] {
  return [
    {
      label,
      rows: lines.map((line) => {
        // An issued line shows the bill as it went out, not today's re-plan:
        // the slip in the tenant's hand is the figure that matters, and a
        // reading added or corrected since must not restate it on screen.
        const bill = line.alreadyIssued;
        const shown = bill
          ? {
              rent: bill.rentAmount,
              electricity: bill.electricityAmount,
              water: bill.waterAmount,
              total: billTotal(bill),
              working:
                bill.electricityPrevious !== null && bill.electricityCurrent !== null
                  ? `${bill.electricityPrevious.toLocaleString('en-US')} → ${bill.electricityCurrent.toLocaleString('en-US')}`
                  : line.electricityBasis,
            }
          : {
              rent: line.rentAmount,
              electricity: line.electricityAmount,
              water: line.waterAmount,
              total: line.total,
              working: [line.rentBasis, line.electricityBasis].filter(Boolean).join(' · '),
            };
        return {
        id: line.roomId,
        cells: {
          room: { kind: 'text', value: line.roomLabel },
          rent: { kind: 'figure', value: shown.rent },
          electricity: { kind: 'figure', value: shown.electricity },
          working: { kind: 'text', value: shown.working, muted: true },
          water: { kind: 'figure', value: shown.water },
          total: { kind: 'figure', value: shown.total },
          state: line.alreadyIssued
            ? { kind: 'pill', tone: 'mute', label: 'ออกแล้ว' }
            : line.problems.length > 0
              ? { kind: 'pill', tone: 'crit', label: line.problems[0]! }
              : line.nothingDue
                ? { kind: 'pill', tone: 'info', label: 'ไม่มียอดรอบนี้' }
                : { kind: 'pill', tone: 'ok', label: 'พร้อมออก' },
          // Its own column, and a real link. Only an issued bill has a
          // document: a planned line is a preview of one that does not exist
          // yet, and a link to it would 404.
          document: line.alreadyIssued
            ? {
                kind: 'link',
                href: consolePath(`console/bills/${line.alreadyIssued.id}`),
                label: 'เปิด / พิมพ์',
              }
            : { kind: 'text', value: '—', muted: true },
        },
      } satisfies LedgerGroup['rows'][number];
      }),
    },
  ];
}

let issued = 0;
let annotated = 0;
let errors: string[] = [];
let submittedNotes: FormData | undefined;

// Issuing always belongs to the cycle you are in — letting someone issue
// into another invites billing a closed month by accident. Other cycles can
// be *opened* to look back at, which is what `past` gates below.
const now = new Date();
const viewed = viewedCycle(Astro.url.searchParams.get('cycle'), now);
const { cycle, past } = viewed;
const options = cycleOptions(now, cycle);

// Rooms whose new tenant the admin chose to charge utilities this cycle —
// by default a tenancy that began this cycle is not (see `movedInDuring`).
// Carried in the query on preview and in the form on issue, so what is
// issued is exactly what was previewed.
function choicesFrom(source: { getAll(name: string): unknown[] }): Map<string, boolean> {
  const charged = new Set(source.getAll('charge').map(String));
  return new Map(source.getAll('newmovein').map(String).map((roomId) => [roomId, charged.has(roomId)]));
}
let utilityChoices = choicesFrom(Astro.url.searchParams);

async function load() {
  const [rooms, leases, readings, existing] = await Promise.all([
    getRoomRepository(env).listRooms(),
    getLeaseRepository(env).listLeases(),
    getMeterReadingRepository(env).listReadings(),
    getBillRepository(env).listBills(),
  ]);
  return planBillRun({ cycle, rooms, leases, readings, existing, utilityChoices });
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const bills = getBillRepository(env);
  utilityChoices = choicesFrom(form);

  // Two actions on one page, told apart by a hidden field rather than by
  // which fields happen to be present — issuing a cycle and annotating one
  // are different enough that guessing between them would eventually guess
  // wrong, and one of the two writes money figures.
  if (form.get('action') === 'annotate') {
    submittedNotes = form;
    const existing = (await bills.listBills()).filter((bill) => bill.cycle === cycle.id);

    for (const update of arrearsUpdatesFromForm(existing, form)) {
      try {
        await bills.annotateArrears(update.billId, update.note);
        annotated += 1;
      } catch (cause) {
        errors.push(`${update.billId}: ${cause instanceof Error ? cause.message : String(cause)}`);
      }
    }
  } else if (past) {
    // The page never offers this, so it is a stale tab or a hand-made POST —
    // refused here rather than trusted to the missing button.
    errors.push('ออกบิลย้อนหลังไม่ได้ — ออกบิลได้เฉพาะรอบปัจจุบัน');
  } else {
    // Re-planned from a fresh read rather than trusting the rendered page: a
    // reading corrected in another tab must change what is issued.
    for (const draft of draftsFrom(await load())) {
      try {
        await bills.issueBill(draft);
        issued += 1;
      } catch (cause) {
        // Per room, not aborting: bills are append-only, so the ones already
        // written are complete and correct on their own.
        errors.push(`${draft.roomId}: ${cause instanceof Error ? cause.message : String(cause)}`);
      }
    }
  }
}

// Reloaded after writing, so every room that just landed shows as ออกแล้ว
// and every note that just saved shows in its field.
const issuedBills = await getBillRepository(env).listBillsForCycle(cycle.id);
// A past cycle is never planned — see the note at the top.
const run = past ? null : await load();
const allRooms = await getRoomRepository(env).listRooms();
// What still needs the admin comes first; issued bills fold away while
// there is anything left to do (found on the live console: two rooms that
// mattered were buried in a 24-row table of finished ones).
const sections = run ? billRunSections(run.lines) : null;
const openGroups = sections
  ? [
      ...(sections.todo.length > 0 ? toGroups(sections.todo, 'ต้องทำ') : []),
      ...(sections.nothingDue.length > 0 ? toGroups(sections.nothingDue, 'ไม่มียอดรอบนี้') : []),
    ]
  : [];
const issuedSectionGroups = sections && sections.issued.length > 0 ? toGroups(sections.issued, cycleLabel(cycle)) : [];
const pastGroups = run ? [] : toIssuedGroups(issuedLines(issuedBills, allRooms), cycleLabel(cycle));
const workLeft = sections ? sections.todo.length > 0 : false;
const blocked = run ? run.lines.filter((l) => l.problems.length > 0 && !l.alreadyIssued).length : 0;
const problems = run ? problemGroups(run.lines) : [];
const issuedCount = run ? run.lines.filter((l) => l.alreadyIssued).length : issuedBills.length;
const issuedTotal = issuedBills.reduce((sum, bill) => sum + billTotal(bill), 0);
// Only re-fill from the submission while something is still wrong; a clean
// save shows what the sheet now holds.
const arrearsGroups = toArrearsGroups(
  issuedBills,
  `บิลที่ออกแล้ว ${cycleLabel(cycle)}`,
  errors.length > 0 ? submittedNotes : undefined,
  new Map(allRooms.map((room) => [room.id, room.label])),
);
---

<ConsoleFrame title="ออกบิล" activeSection="bills">
  <PageHeader
    eyebrow="ขั้น 3 จาก 6"
    title={past ? 'บิลที่ออกไปแล้ว' : 'ออกบิลประจำรอบ'}
    subtitle={`${rentLabel(cycle)} + ${utilityLabel(cycle)} · ${cycleLabel(cycle)}`}
  >
    <CyclePicker slot="actions" {options} selected={cycle} />
  </PageHeader>

  {viewed.problem && <Notice tone="warn">{viewed.problem}</Notice>}
  {past && (
    <Notice tone="info">รอบย้อนหลัง — ดูได้อย่างเดียว ออกบิลได้เฉพาะ<a href={consolePath('console/bills')} class={LINK}>รอบปัจจุบัน</a></Notice>
  )}

  {issued > 0 && <Notice tone="ok" role="status">ออกบิลแล้ว {issued} ใบ</Notice>}
  {annotated > 0 && <Notice tone="ok" role="status">บันทึกหมายเหตุแล้ว {annotated} รายการ</Notice>}
  <ErrorSummary message={errors.length > 0 ? errors.join('\n') : null} />

  {run && (
    <div class="mb-4 grid grid-cols-3 gap-1.5 desk:gap-3.5">
      <StatTile mark="done" count={issuedCount} label="ออกบิลแล้ว" />
      <StatTile mark="todo" count={run.issuable.length} label="พร้อมออก" />
      <StatTile mark={blocked > 0 ? 'missing' : 'none'} count={blocked} label="รอข้อมูล" />
    </div>
  )}

  {/* Blocked rooms, one card per reason with one fix — never a row each. */}
  {problems.length > 0 && (
    <div class="mb-5 flex flex-col gap-3">
      {problems.map((problem) => (
        <ProblemCard
          layout="row"
          title={problem.title}
          items={problem.rooms.map((r) => ({ label: r.label, href: r.href }))}
          action={problem.action}
        />
      ))}
    </div>
  )}

  {run ? (
    <Fragment>
      {openGroups.length > 0 && <LedgerTable columns={COLUMNS} groups={openGroups} />}
      {issuedSectionGroups.length > 0 && (
        <details class="mt-4" open={!workLeft}>
          <summary class="flex min-h-11 cursor-pointer items-center gap-2 text-[15px] font-semibold text-console-ink">
            ออกแล้ว {sections!.issued.length} ใบ · รวม {formatBaht(issuedTotal)} บาท
            {workLeft && <span class="text-sm font-normal text-console-ink-soft">(กดเพื่อดู)</span>}
          </summary>
          <LedgerTable columns={COLUMNS} groups={issuedSectionGroups} />
        </details>
      )}
    </Fragment>
  ) : (
    <LedgerTable columns={COLUMNS} groups={pastGroups} />
  )}

  {/* A disabled button whose label states a fact reads like an action you
      cannot take, and the reader is left wondering what it would have done.
      With nothing to issue there is no action, so there is no button —
      a sentence says why, and points at what is usually the reason. */}
  {run && run.lines.some((line) => line.newMoveIn && !line.alreadyIssued) && (
    <form method="GET" class="mt-4 rounded-xl border border-console-info/30 bg-console-info-bg px-4 py-3 text-[15px] text-console-ink">
      <p class="m-0 font-semibold">ห้องที่เข้าใหม่ระหว่างรอบ</p>
      <p class="m-0 mb-2 text-sm text-console-ink-soft">
        ถ้าเข้าก่อนวันจดมิเตอร์ไม่เกิน 10 วัน ระบบจะไม่คิดค่าน้ำค่าไฟรอบแรก (เหมือนแบบฟอร์มกระดาษ) — ติ๊ก/เอาติ๊กออกแล้วกดคำนวณใหม่
      </p>
      <input type="hidden" name="cycle" value={cycle.id} />
      <div class="flex flex-wrap items-center gap-4">
        {run.lines.filter((line) => line.newMoveIn && !line.alreadyIssued).map((line) => (
          <label class="inline-flex min-h-11 items-center gap-2">
            <input type="hidden" name="newmovein" value={line.roomId} />
            <input type="checkbox" name="charge" value={line.roomId} checked={!line.utilitiesWaived} class="h-5 w-5" />
            คิดค่าน้ำค่าไฟห้อง {line.roomLabel}
          </label>
        ))}
        <Button type="submit" variant="secondary" size="md">คำนวณใหม่</Button>
      </div>
    </form>
  )}

  <div class="mt-4 flex flex-col gap-3 desk:flex-row desk:flex-wrap desk:items-center">
    {!run ? (
      <Notice tone="mute" flush class="desk:flex-1">
        {issuedBills.length === 0
          ? 'รอบนี้ไม่ได้ออกบิลไว้'
          : `ออกไป ${issuedBills.length} ใบ รวม ${formatBaht(issuedTotal)} บาท`}
      </Notice>
    ) : run.issuable.length === 0 ? (
      <Notice tone="mute" flush class="desk:flex-1">
        {run.lines.length === 0
          ? 'ยังไม่มีห้องที่ต้องออกบิลรอบนี้'
          : run.lines.every((line) => line.alreadyIssued || line.nothingDue)
            ? 'ออกบิลครบทุกห้องแล้วสำหรับรอบนี้ — เปิดใบแจ้งได้จากคอลัมน์ขวาสุด'
            : 'ยังออกบิลไม่ได้ — แก้ตามการ์ดสีแดงด้านบนก่อน'}
      </Notice>
    ) : (
      <form method="POST" class="flex flex-col gap-2 desk:flex-row desk:items-center desk:gap-4">
        <input type="hidden" name="action" value="issue" />
        {run.lines.filter((line) => line.newMoveIn && !line.alreadyIssued).map((line) => (
          <Fragment>
            <input type="hidden" name="newmovein" value={line.roomId} />
            {!line.utilitiesWaived && <input type="hidden" name="charge" value={line.roomId} />}
          </Fragment>
        ))}
        <Button type="submit" size="lg">ออกบิล {run.issuable.length} ใบ</Button>
        <p class="font-figure text-[15px] tabular-nums text-console-ink-soft">
          ยอดที่จะออกรอบนี้ <span class="font-semibold text-console-ink">{formatBaht(run.total)}</span> บาท
        </p>
      </form>
    )}
    {/* The run, not the slip. Printing a cycle one bill at a time is the thing
        KS-24 was actually missing, so the way in belongs on the page where the
        cycle is issued — not only in the rightmost column of each row. */}
    {issuedBills.length > 0 && (
      <Button href={`${consolePath('console/bills/print')}?cycle=${cycle.id}`} variant="secondary" size="lg">
        พิมพ์ใบแจ้งทั้งหมด ({issuedBills.length})
      </Button>
    )}
    {issuedBills.length > 0 && (
      <Button
        href={past ? `${consolePath('console/payments')}?cycle=${cycle.id}` : consolePath('console/payments')}
        variant="secondary"
        size="lg"
      >
        {past ? 'ดูการรับเงินรอบนี้ →' : 'ไปขั้น 4 รับเงิน →'}
      </Button>
    )}
  </div>

  {issuedBills.length > 0 && (
    <section class="mt-10">
      <h2 class={SECTION_TITLE}>หมายเหตุ / ยอดค้าง</h2>
      <p class="mb-3 text-[15px] text-console-ink-soft">
        เขียนเองทั้งหมด คอนโซลไม่คิดยอดค้างให้ — เว้นว่างไว้คือเคลียร์แล้ว
        (ยอดค้าง กับ ค้างประกัน เป็นคนละเรื่องกัน มีแต่คนเท่านั้นที่รู้ว่าอันไหน)
      </p>

      <form method="POST">
        <input type="hidden" name="action" value="annotate" />
        <LedgerTable columns={ARREARS_COLUMNS} groups={arrearsGroups} />

        <div class="mt-4">
          <Button type="submit" variant="secondary" size="lg">บันทึกหมายเหตุ</Button>
        </div>
      </form>
    </section>
  )}
</ConsoleFrame>
