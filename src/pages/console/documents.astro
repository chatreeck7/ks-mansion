---
// src/pages/console/documents.astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import Button from '@/components/console/Button.astro';
import Notice from '@/components/console/Notice.astro';
import PageHeader from '@/components/console/PageHeader.astro';
import { FOCUS, INPUT } from '@/lib/console/ui';
import { consolePath } from '@/lib/console/paths';
import {
  documentTypesFor,
  isReady,
  selectedDocuments,
  selectionFrom,
} from '@/lib/console/document-types';
import { formatThaiMonth } from '@/lib/format/thai';
import { cycleFor, cycleFromId, cycleLabel, cycleOptions } from '@/lib/models/billing-cycle';

/**
 * Pick which documents to produce for a month (KS-27, AC-4.1).
 *
 * **The selection lives in the URL**, as `?cycle=` and `?include=`, so a set
 * of documents is a link — bookmarkable, shareable, and the same shape
 * `documents/print.astro` reads to assemble them into one file (KS-30). That
 * is why this is a plain GET form rather than something that keeps its state
 * on the client.
 *
 * **"รวมเป็นไฟล์เดียว" submits this same form to the print route**
 * (`formaction`), so what gets printed is whatever is ticked at that moment —
 * no separate "apply" step between ticking and printing.
 *
 * **The cycle picker is not `CyclePicker`.** That control submits the moment
 * you choose, which is right where the month *is* the whole choice; here it
 * is one field among several, and auto-submitting would throw away the boxes
 * you had just ticked. So the month sits inside this form and the ดู button
 * applies the lot — the button earns its place here in a way it did not
 * there.
 */

const now = new Date();
const requested = Astro.url.searchParams.get('cycle');
const chosen = cycleFromId(requested);
const unknownCycle = requested !== null && chosen === null;
const cycle = chosen ?? cycleFor(now);
const options = cycleOptions(now, chosen);

const types = documentTypesFor(cycle);

/**
 * Absent and empty have to stay distinguishable, and an all-unticked
 * checkbox group submits nothing at all. The hidden empty `include` below
 * keeps the parameter present, so "I unticked everything" arrives as an
 * empty selection instead of looking like a first visit.
 */
const raw = Astro.url.searchParams.has('include')
  ? Astro.url.searchParams.getAll('include').join(',')
  : null;
const selection = selectionFrom(raw, types);
const selected = selectedDocuments(selection, types);

const ready = types.filter(isReady);
const pending = types.filter((type) => !isReady(type));
---

<ConsoleFrame title="เอกสาร" activeSection="documents" width="reading">
  <PageHeader
    eyebrow="ขั้น 6 จาก 6"
    title="เอกสารประจำรอบ"
    subtitle="ติ๊กเอกสารที่ต้องการ แล้วรวมเป็นไฟล์เดียว · พิมพ์ A4 · ลิงก์หน้านี้จำสิ่งที่เลือกไว้"
  />

  {unknownCycle && <Notice tone="warn">ไม่รู้จักรอบ "{requested}" — แสดงรอบปัจจุบันแทน</Notice>}

  <form method="GET" data-documents>
    <label class="mb-4 flex max-w-md flex-col gap-1 text-[15px] font-medium text-console-ink-soft">
      เดือน
      <select name="cycle" class={INPUT} data-cycle>
        {options.map((option) => (
          <option value={option.id} selected={option.id === cycle.id}>
            {formatThaiMonth(option.utilityMonth)} — {cycleLabel(option)}
          </option>
        ))}
      </select>
    </label>

    {/* Keeps `include` in the query even when every box is unticked — see
        the note in the frontmatter. */}
    <input type="hidden" name="include" value="" />

    <fieldset class="m-0 border-0 p-0">
      <legend class="sr-only">เอกสารที่จะเอา</legend>
      <ul class="m-0 list-none border-t-2 border-console-ink p-0">
        {ready.map((type) => (
          <li class="flex items-center gap-3 border-b border-console-rule">
            <label class="flex min-h-16 flex-1 cursor-pointer items-center gap-3.5 py-1 pl-1 desk:pl-3">
              <input
                type="checkbox"
                name="include"
                value={type.id}
                checked={selection.includes(type.id)}
                class="peer sr-only"
              />
              <span
                aria-hidden="true"
                class="flex h-7 w-7 flex-none items-center justify-center rounded-md border-2 border-console-ink text-base font-semibold text-transparent peer-checked:bg-console-ink peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-console-ink"
              >
                ✓
              </span>
              <span class="flex flex-col leading-snug">
                <span class="text-[17px] font-semibold">{type.label}</span>
                <span class="text-[15px] text-console-ink-soft">{type.description}</span>
              </span>
            </label>
            <a
              href={(type.availability as { href: string }).href}
              class:list={['flex min-h-11 items-center whitespace-nowrap pr-1 text-[15px] font-semibold text-console-ink no-underline hover:underline desk:pr-3', FOCUS]}
            >
              ดูตัวอย่าง
            </a>
          </li>
        ))}
        {/* Listed rather than hidden: a selector showing only what exists looks
            finished when it is not, and the person who would ask for the missing
            ones is exactly the person reading this screen. Said in plain words. */}
        {pending.map((type) => (
          <li class="flex min-h-16 items-center gap-3.5 border-b border-console-rule py-1 pl-1 opacity-75 desk:pl-3">
            <span aria-hidden="true" class="h-7 w-7 flex-none rounded-md border-2 border-dashed border-console-ink-faint" />
            <span class="flex flex-col leading-snug">
              <span class="text-[17px] font-semibold text-console-ink-soft">{type.label}</span>
              <span class="text-[15px] text-console-ink-faint">ยังทำไม่ได้: {(type.availability as { reason: string }).reason}</span>
            </span>
          </li>
        ))}
      </ul>
    </fieldset>

    <div class="sticky bottom-16 -mx-4 mt-4 flex flex-wrap items-center gap-3 border-t border-console-line bg-console-paper px-4 py-3 desk:static desk:mx-0 desk:border-0 desk:bg-transparent desk:p-0">
      <Button
        type="submit"
        size="lg"
        formaction={consolePath('console/documents/print')}
        class="flex-1 desk:flex-none"
      >
        รวมเป็น PDF ไฟล์เดียว{selected.length > 0 ? ` (${selected.length})` : ''}
      </Button>
      <noscript>
        <Button type="submit" variant="secondary" size="lg">อัปเดตรายการ</Button>
      </noscript>
    </div>
  </form>
</ConsoleFrame>

<script>
  // The month is part of the selection; changing it reloads this page with
  // the ticks kept, rather than printing. The form's own submit button goes
  // to the print route instead (see `formaction`).
  const form = document.querySelector<HTMLFormElement>('form[data-documents]');
  form?.querySelector('[data-cycle]')?.addEventListener('change', () => form.submit());
</script>
