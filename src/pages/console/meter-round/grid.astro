---
// src/pages/console/meter-round/grid.astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import Button from '@/components/console/Button.astro';
import ErrorSummary from '@/components/console/ErrorSummary.astro';
import Notice from '@/components/console/Notice.astro';
import PageHeader from '@/components/console/PageHeader.astro';
import LedgerTable from '@/components/console/LedgerTable.astro';
import { draftsFromForm, METER_GRID_COLUMNS, toMeterGridGroups } from '@/lib/console/meter-grid';
import { saveRoundReading } from '@/lib/console/meter-reading-save';
import { startMetersFor, startRound } from '@/lib/console/meter-round';
import { consolePath } from '@/lib/console/paths';
import { cycleFor } from '@/lib/models/billing-cycle';
import { notebookShortName } from '@/lib/console/logbook';
import {
  getBillRepository,
  getLeaseRepository,
  getMeterReadingRepository,
  getRoomRepository,
} from '@/lib/repositories';

/**
 * The desk-side meter grid (KS-60).
 *
 * Unlike the stepper this keeps the ordinary console chrome: someone here is
 * sitting down, has noticed one wrong figure, and will want to go somewhere
 * else afterwards. It is the same stop list in a different input register.
 *
 * A plain `<form>` with no island, deliberately. "Tab down the rooms, correct
 * a reading, save" is what a form already does — reimplementing focus order
 * in JavaScript would be strictly worse at it, and this screen has no need to
 * hold state between keystrokes the way the stepper does.
 */

const env = Astro.locals.runtime?.env;

let errors: string[] = [];
/** Stops whose reading actually landed, so their inputs can be cleared. */
const savedKeys = new Set<string>();
let submitted: FormData | undefined;

/**
 * The cycle every reading in this submission is filed under.
 *
 * Recomputed on POST rather than carried in a hidden field: the sheet is the
 * record, and a stale date posted from a tab left open overnight would file a
 * correction into the wrong cycle.
 */
const readDate = new Date();

if (Astro.request.method === 'POST') {
  submitted = await Astro.request.formData();
}

// Read after the form, so a save is followed by a fresh view of what the
// sheet now holds rather than by what it held when the page was opened.
const cycle = cycleFor(readDate);
const [rooms, history, leases] = await Promise.all([
  getRoomRepository(env).listRooms(),
  getMeterReadingRepository(env).listReadings(),
  getLeaseRepository(env).listLeases(),
]);
// This notebook page's round: ครั้งก่อน is last round's close and does not
// move when a figure is saved; a saved figure shows in ครั้งหลัง.
let round = startRound(rooms, history, cycle, leases);
const startMeters = startMetersFor(leases, cycle);
/**
 * What the sheet holds *now*, which after a save is not `history` any more.
 *
 * The จดรอบนี้ column is read off this: it shows the saved figure's date
 * and working.
 */
let known = history;

if (submitted) {
  const submission = draftsFromForm(round, submitted, readDate);
  errors = [...submission.errors];

  const readings = getMeterReadingRepository(env);
  const bills = getBillRepository(env);
  const labels = new Map(rooms.map((room) => [room.id, room.label]));
  for (const { stopKey, draft } of submission.entries) {
    try {
      // Replaces a figure already saved this round rather than stacking on it.
      await saveRoundReading({ readings, bills }, draft, cycle, {
        roomLabel: labels.get(draft.roomId),
        startMeter: startMeters.get(draft.roomId) ?? null,
      });
      savedKeys.add(stopKey);
    } catch (cause) {
      // Reported per row rather than aborting the rest. Readings are
      // append-only, so the ones already written are correct and complete on
      // their own — stopping would leave the admin unable to tell which of
      // the 27 had landed.
      const reason = cause instanceof Error ? cause.message : String(cause);
      errors.push(`${draft.roomId} (${draft.meterType}): ${reason}`);
    }
  }

  if (savedKeys.size > 0) {
    // Rebuild from the sheet so each saved row now shows its new figure as
    // the one the next reading continues from — and so the รอบนี้ column is
    // answered by what was actually written, not by what was submitted.
    known = await readings.listReadings();
    round = startRound(rooms, known, cycle, leases);
  }
}

// Put back only what still needs attention. A row that saved clears — its
// figure is on the sheet now, and leaving it in the field invites a second
// submit that appends the same reading again as zero units against itself.
const saved = savedKeys.size;
const groups = toMeterGridGroups(
  round,
  readDate,
  errors.length > 0 ? submitted : undefined,
  savedKeys,
  known,
);
---

<ConsoleFrame title="จดมิเตอร์" activeSection="meter-round">
  <PageHeader
    eyebrow="ขั้น 1 จาก 6"
    title={`จดมิเตอร์ไฟ · สมุดเดือน ${notebookShortName(cycle)}`}
    subtitle={`จดวันที่ ${cycle.readFrom.getDate()} · ครั้งก่อน = เลขปิดรอบที่แล้ว ไม่เปลี่ยนทั้งรอบ · กรอกเฉพาะช่องครั้งหลัง`}
  >
    <a
      slot="actions"
      href={consolePath('console/meter-round')}
      class="flex items-center gap-3 rounded-[10px] border-[1.5px] border-console-ink bg-console-card px-3.5 py-2.5 text-console-ink no-underline hover:bg-console-highlight/30"
    >
      <span class="flex h-11 w-11 flex-none items-center justify-center rounded-md bg-console-hatch font-hand text-xl font-semibold" aria-hidden="true">✎</span>
      <span class="text-[15px] font-medium leading-snug">
        เดินจดด้วยมือถือ →<br /><span class="text-console-ink-soft">แป้นตัวเลข ทีละห้อง</span>
      </span>
    </a>
  </PageHeader>

  {saved > 0 && errors.length === 0 && (
    <Notice tone="ok" role="status">บันทึกแล้ว {saved} รายการ</Notice>
  )}
  {saved > 0 && errors.length > 0 && (
    <Notice tone="warn" role="status">บันทึกแล้ว {saved} รายการ ส่วนที่เหลือยังไม่ผ่าน — ดูด้านล่าง</Notice>
  )}
  <ErrorSummary message={errors.length > 0 ? errors.join('\n') : null} />

  <form method="POST" data-meter-grid>
    <LedgerTable columns={METER_GRID_COLUMNS} groups={groups} sheet />

    <div class="mt-4 flex flex-col gap-3 desk:flex-row desk:items-center desk:justify-between">
      <p class="text-[15px] text-console-ink-soft">
        กรอกผิด พิมพ์ทับในช่องครั้งหลังแล้วกดบันทึกได้เลย ค่าใหม่แทนค่าเดิม (ค่าเดิมเก็บเข้าคลัง) · ห้องที่ออกบิลรอบนี้แล้วแก้ไม่ได้
      </p>
      <Button type="submit" size="lg">บันทึกเลขมิเตอร์</Button>
    </div>
  </form>
</ConsoleFrame>

<script>
  // Spreadsheet keys: Enter or ↓ moves down the column, ↑ moves up — the
  // round is typed top to bottom, one dial after another, like the paper
  // sheet. Enter never submits from a cell; the button does that.
  document.addEventListener('keydown', (event) => {
    const input = event.target as HTMLInputElement | null;
    const column = input?.dataset?.sheetInput;
    if (!input || !column) return;
    const down = event.key === 'Enter' || event.key === 'ArrowDown';
    const up = event.key === 'ArrowUp';
    if (!down && !up) return;
    event.preventDefault();
    const cells = [...document.querySelectorAll<HTMLInputElement>(`[data-sheet-input="${column}"]`)];
    const next = cells[cells.indexOf(input) + (down ? 1 : -1)];
    if (next) {
      next.focus();
      next.select();
    }
  });

  // A dial misread is the slip that costs the most later — a bill worked
  // from it. Saving asks only when something looks off: a reading below the
  // last one, or units far above the rest of the round.
  import { guardForm, type ConfirmRow } from '@/lib/console/confirm-dialog';
  import { parseFigure } from '@/lib/format/figure';
  import { formatFigure } from '@/lib/format/thai';

  const grid = document.querySelector<HTMLFormElement>('form[data-meter-grid]');
  if (grid) {
    guardForm(grid, () => {
      const typed = [...grid.querySelectorAll<HTMLInputElement>('input[name^="current:"]')]
        .map((input) => {
          const previous = parseFigure(input.closest('td')?.previousElementSibling?.textContent ?? '');
          const current = parseFigure(input.value);
          const room = input.closest('tr')?.querySelector('td')?.textContent?.trim() ?? '';
          return { input, room, previous, current };
        })
        .filter((row) => row.previous !== null && row.current !== null && !Number.isNaN(row.current) && !Number.isNaN(row.previous!));
      const units = typed.map((row) => row.current! - row.previous!).filter((u) => u > 0).sort((a, b) => a - b);
      const median = units.length ? units[Math.floor(units.length / 2)]! : 0;
      const odd: ConfirmRow[] = [];
      for (const row of typed) {
        if (row.input.value === row.input.defaultValue) continue;
        const used = row.current! - row.previous!;
        if (used < 0) {
          odd.push({ label: `ห้อง ${row.room}`, value: `${formatFigure(row.previous!)} → ${formatFigure(row.current!)}`, note: 'เลขใหม่น้อยกว่าครั้งก่อน', warn: true });
        } else if (median > 0 && used > Math.max(median * 3, 300)) {
          odd.push({ label: `ห้อง ${row.room}`, value: `${formatFigure(used)} หน่วย`, note: `สูงกว่าห้องอื่นมาก (ทั่วไปราว ${formatFigure(median)} หน่วย) — ตรวจหลักของเลขอีกครั้ง`, warn: true });
        }
      }
      if (odd.length === 0) return null;
      return {
        title: `ตรวจเลขมิเตอร์ ${odd.length} ห้องก่อนบันทึก`,
        message: 'เลขเหล่านี้ดูผิดปกติ ถ้าถูกต้องแล้วกดบันทึกได้เลย',
        rows: odd,
        confirmLabel: 'ถูกต้อง บันทึก',
      };
    });
  }
</script>
