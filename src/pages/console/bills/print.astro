---
// src/pages/console/bills/print.astro
import BillSlips from '@/components/console/BillSlips.astro';
import PrintShell from '@/components/console/PrintShell.astro';
import { billBatchFor } from '@/lib/console/bill-batch';
import { letterheadFrom, payeeFrom, PAYEE_KEYS } from '@/lib/console/letterhead';
import { collectingCycle } from '@/lib/console/history';
import { consolePath } from '@/lib/console/paths';
import { formatBaht } from '@/lib/format/thai';
import { cycleFromId, cycleLabel, cycleOptions } from '@/lib/models/billing-cycle';
import { getBillRepository, getPaymentRepository, getRoomRepository, getSettingsRepository } from '@/lib/repositories';

/**
 * The whole cycle's bills, one per sheet of paper (KS-24).
 *
 * **This is the 26th.** Twenty-three bills get issued and every one has to be
 * printed and delivered; doing that a URL at a time was the gap between "the
 * console can render a bill" and "the console can do the bill run".
 *
 * What prints is exactly what `/console/bills/<id>` prints — same component,
 * so a slip from the stack and a reprint for a tenant who lost theirs are the
 * same document. The only thing this page adds is where the pages break.
 *
 * Static route, so it wins over `[bill].astro` — no bill is ever called
 * `print`, but the ordering is Astro's and not a coincidence worth relying on
 * silently.
 */

const env = Astro.locals.runtime?.env;

const requested = Astro.url.searchParams.get('cycle');
const chosen = cycleFromId(requested);
// A typed or stale `?cycle=` says so rather than quietly printing a different
// month than the one in the address bar — the same rule the collection sheet
// follows, and it matters more here because the output gets handed out.
const unknownCycle = requested !== null && chosen === null;
const now = new Date();
const cycle = chosen ?? collectingCycle(await getBillRepository(env).listBills(), now);
// Two slips to an A4 sheet by default (7 พ.ย. 2569) — `?per=1` for one.
const perPage = Astro.url.searchParams.get('per') === '1' ? 1 : 2;
const perHref = (per: 1 | 2) => `${consolePath('console/bills/print')}?cycle=${cycle.id}${per === 1 ? '&per=1' : ''}`;
// Always contains `cycle`, so the control names the month on screen even for
// a bookmarked link older than the recent window.
const options = cycleOptions(now, cycle);

const [bills, rooms, payments] = await Promise.all([
  getBillRepository(env).listBillsForCycle(cycle.id),
  getRoomRepository(env).listRooms(),
  getPaymentRepository(env).listPayments(),
]);

const batch = billBatchFor(cycle, bills, rooms, payments);
const documentSettings = await getSettingsRepository(env).resolveSettings();
const letterhead = letterheadFrom(env, documentSettings);
const payee = payeeFrom(env, documentSettings);
---

<PrintShell
  title={`ใบแจ้งค่าห้องพัก ${cycleLabel(cycle)}`}
  back={{ href: consolePath('console/bills'), label: '← กลับไปหน้าบิล' }}
  cycles={{ options, selected: cycle }}
  paper={perPage === 2 ? 'half' : 'tenant'}
  building={letterhead.name}
  printLabel={batch.documents.length > 0 ? `พิมพ์ ${batch.documents.length} ใบ / บันทึกเป็น PDF` : 'พิมพ์'}
  hint={`${cycleLabel(cycle)} — เรียงตามลำดับที่เดินเก็บ · ${perPage === 2 ? 'A4 หน้าละ 2 ใบ ตัดครึ่งตามเส้นประ' : 'หน้าละ 1 ใบ'}${batch.documents.length > 0 ? ` · รวม ${formatBaht(batch.total)} บาท` : ''}`}
>
  <div slot="controls" class="flex flex-col gap-1">
    <span class="text-[15px] font-medium text-console-ink-soft">การพิมพ์</span>
    <div class="flex gap-2">
      <a href={perHref(2)} aria-current={perPage === 2 ? 'page' : undefined} class:list={['inline-flex min-h-11 items-center rounded-lg border-[1.5px] px-3 no-underline', perPage === 2 ? 'border-console-ink bg-console-ink text-white' : 'border-console-line-strong bg-console-card text-console-ink']}>หน้าละ 2 ใบ</a>
      <a href={perHref(1)} aria-current={perPage === 1 ? 'page' : undefined} class:list={['inline-flex min-h-11 items-center rounded-lg border-[1.5px] px-3 no-underline', perPage === 1 ? 'border-console-ink bg-console-ink text-white' : 'border-console-line-strong bg-console-card text-console-ink']}>หน้าละ 1 ใบ</a>
    </div>
  </div>
  <Fragment slot="notices">
    {unknownCycle && (
      <p class="mb-0 mt-3 rounded-lg bg-console-warn-bg px-3 py-2 text-sm text-console-warn">ไม่รู้จักรอบ "{requested}" — แสดงรอบล่าสุดแทน</p>
    )}
    {!payee.configured && (
      <p class="mb-0 mt-3 rounded-lg bg-console-crit-bg px-3 py-2 text-sm text-console-crit">
        ยังไม่ได้ตั้งค่าบัญชีรับโอน (หน้าแม่แบบเอกสาร) — พิมพ์ออกไปตอนนี้ผู้เช่าจะโอนเงินไม่ได้ ตั้งค่าแล้วพิมพ์ใหม่ได้เลย ไม่ต้องออกบิลใหม่
      </p>
    )}
  </Fragment>
  {batch.documents.length === 0 ? (
    <p class="text-[15px]">ยังไม่ได้ออกบิลรอบนี้ — ออกบิลที่หน้าบิลก่อน แล้วกลับมาพิมพ์</p>
  ) : (
    <BillSlips docs={batch.documents} {letterhead} {payee} {perPage} />
  )}
</PrintShell>
