---
// src/pages/console/login.astro
// The one console route the middleware leaves open — see src/lib/auth/guard.ts.
import ConsoleLayout from '@/layouts/ConsoleLayout.astro';
import { safeNextPath } from '@/lib/auth/guard';
import { readAuthSecrets } from '@/lib/auth/secrets';
import { verifyPassword } from '@/lib/auth/password';
import { createSessionToken } from '@/lib/auth/session';
import { SESSION_COOKIE } from '@/middleware';

const SESSION_HOURS = 12;

const secrets = readAuthSecrets(Astro.locals.runtime?.env as Record<string, unknown>);
if (!secrets) {
  return new Response('Console auth is not configured.', {
    status: 503,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

let error = '';
let next = safeNextPath(Astro.url.searchParams.get('next'));

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  next = safeNextPath(String(form.get('next') ?? ''));

  if (await verifyPassword(String(form.get('password') ?? ''), secrets.passwordHash)) {
    const expiresAt = Date.now() + SESSION_HOURS * 60 * 60 * 1000;
    Astro.cookies.set(SESSION_COOKIE, await createSessionToken(secrets.sessionSecret, expiresAt), {
      httpOnly: true,
      // Not readable by JS, not sent cross-site, HTTPS-only in production.
      secure: import.meta.env.PROD,
      sameSite: 'lax',
      path: '/',
      expires: new Date(expiresAt),
    });
    return Astro.redirect(next, 302);
  }

  // Deliberately does not say whether it was the password or anything else.
  error = 'รหัสผ่านไม่ถูกต้อง';
}
---

<ConsoleLayout title="เข้าสู่ระบบ">
  <main class="mx-auto flex min-h-[60vh] max-w-sm flex-col justify-center px-4">
    <h1 class="mb-1 text-xl font-medium text-console-ink">KS Mansion</h1>
    <p class="mb-6 text-sm text-console-ink-faint">ระบบจัดการภายใน</p>

    <form method="POST" class="flex flex-col gap-3">
      <input type="hidden" name="next" value={next} />

      <label class="text-sm text-console-ink-soft" for="password">รหัสผ่าน</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
        autofocus
        class="rounded border border-console-sunk bg-console-card px-3 py-2 text-console-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
      />

      {error && <p class="text-sm text-console-crit" role="alert">{error}</p>}

      <button
        type="submit"
        class="mt-1 rounded bg-console-ink px-3 py-2 text-sm text-console-card hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
      >
        เข้าสู่ระบบ
      </button>
    </form>
  </main>
</ConsoleLayout>
