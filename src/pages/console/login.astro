---
// src/pages/console/login.astro
// The one console route the middleware leaves open — see src/lib/auth/guard.ts.
import ConsoleLayout from '@/layouts/ConsoleLayout.astro';
import Button from '@/components/console/Button.astro';
import { INPUT } from '@/lib/console/ui';
import { safeNextPath } from '@/lib/auth/guard';
import { readAuthSecrets } from '@/lib/auth/secrets';
import { verifyPassword } from '@/lib/auth/password';
import { createSessionToken } from '@/lib/auth/session';
import { SESSION_COOKIE } from '@/middleware';

const SESSION_HOURS = 12;

const secrets = readAuthSecrets(Astro.locals.runtime?.env as Record<string, unknown>);
if (!secrets) {
  return new Response('Console auth is not configured.', {
    status: 503,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

let error = '';
let next = safeNextPath(Astro.url.searchParams.get('next'));

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  next = safeNextPath(String(form.get('next') ?? ''));

  if (await verifyPassword(String(form.get('password') ?? ''), secrets.passwordHash)) {
    const expiresAt = Date.now() + SESSION_HOURS * 60 * 60 * 1000;
    Astro.cookies.set(SESSION_COOKIE, await createSessionToken(secrets.sessionSecret, expiresAt), {
      httpOnly: true,
      // Not readable by JS, not sent cross-site, HTTPS-only in production.
      secure: import.meta.env.PROD,
      sameSite: 'lax',
      path: '/',
      expires: new Date(expiresAt),
    });
    return Astro.redirect(next, 302);
  }

  // Deliberately does not say whether it was the password or anything else.
  error = 'รหัสผ่านไม่ถูกต้อง';
}
---

<ConsoleLayout title="เข้าสู่ระบบ">
  <main class="console-root flex min-h-[100dvh] items-center justify-center px-4 desk:bg-console-ruled">
    <div class="w-full max-w-sm rounded-xl border border-console-line bg-console-card p-6 shadow-[0_8px_24px_rgba(30,45,74,0.12)]">
      <p class="text-[13px] font-semibold tracking-[0.12em] text-console-ink-soft">KS MANSION</p>
      <h1 class="mb-1 font-hand text-[28px] font-semibold leading-[1.4]">สมุดประจำเดือน</h1>
      <p class="mb-6 text-[15px] text-console-ink-soft">ระบบจัดการภายในของตึก</p>

      <form method="POST" class="flex flex-col gap-3">
        <input type="hidden" name="next" value={next} />

        <label class="text-[15px] font-medium text-console-ink-soft" for="password">รหัสผ่าน</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          autofocus
          aria-invalid={error ? 'true' : undefined}
          class:list={[INPUT, error && 'border-console-crit']}
        />

        {error && <p class="text-[15px] font-medium text-console-crit" role="alert">{error}</p>}

        <Button type="submit" size="lg" full class="mt-1">เข้าสู่ระบบ</Button>
      </form>
    </div>
  </main>
</ConsoleLayout>
