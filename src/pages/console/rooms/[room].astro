---
// src/pages/console/rooms/[room].astro
import ConsoleFrame from '@/components/console/ConsoleFrame.astro';
import DetailSheet from '@/components/console/DetailSheet.astro';
import DetailSection from '@/components/console/DetailSection.astro';
import LeaseSection from '@/components/console/LeaseSection.astro';
import { formatFigure } from '@/lib/format/thai';
import { isUnit, statusLabel } from '@/lib/models/room';
import { displayName } from '@/lib/models/tenant';
import { consolePath } from '@/lib/console/paths';
import { getLeaseRepository, getRoomRepository, getTenantRepository } from '@/lib/repositories';

const env = Astro.locals.runtime?.env;

// Resolved per request rather than at build time: room data comes from
// Sheets, where an admin's edit must show up without a redeploy.
const room = await getRoomRepository(env).getRoom(Astro.params.room!);

if (!room) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const leases = await getLeaseRepository(env).listLeasesForRoom(room.id);

// Resolve tenant names once for the leases actually shown, rather than
// per-lease inside the template — that would be a Sheets read each.
const tenants = leases.length > 0 ? await getTenantRepository(env).listTenants() : [];
const tenantNameById = new Map(tenants.map((t) => [t.id, displayName(t)]));

const location = isUnit(room) ? `ชั้น ${room.floor}` : 'พื้นที่ส่วนกลาง';
const rentClause = room.rentRate !== null ? ` · ค่าเช่า ${formatFigure(room.rentRate)} ต่อเดือน` : '';
const meta = `${location}${rentClause}`;

// Named individually rather than as a joined list, so "no TV on record"
// stays distinguishable from a shorter list of what the room does have.
// Three states, not two: an em dash means nobody has surveyed it, which is
// a different claim from 'ไม่มี'.
const APPLIANCES = [
  { label: 'แอร์', present: room.appliances.aircon },
  { label: 'ทีวี', present: room.appliances.tv },
  { label: 'ตู้เย็น', present: room.appliances.fridge },
].map(({ label, present }) => ({
  label,
  value: present === null ? '—' : present ? 'มี' : 'ไม่มี',
}));
---

<ConsoleFrame title={`ห้อง ${room.label}`} activeSection="rooms">
  <DetailSheet title={room.label} meta={meta}>
    <DetailSection heading="ข้อมูลห้อง">
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-console-ink-faint">ประเภท</dt>
        <dd>{isUnit(room) ? 'ห้องให้เช่า' : 'พื้นที่ส่วนกลาง'}</dd>
        <dt class="text-console-ink-faint">สถานะ</dt>
        <dd>{statusLabel(room.status)}</dd>
        <dt class="text-console-ink-faint">มิเตอร์ไฟ</dt>
        <dd>{room.hasMeter ? 'มี' : 'ไม่มี'}</dd>
        {
          APPLIANCES.map((appliance) => (
            <>
              <dt class="text-console-ink-faint">{appliance.label}</dt>
              <dd>{appliance.value}</dd>
            </>
          ))
        }
      </dl>
    </DetailSection>

    <LeaseSection
      leases={leases}
      addHref={consolePath(`console/leases/new?room=${room.id}`)}
      counterpartLabel="ผู้เช่า"
      counterpartFor={(lease) => tenantNameById.get(lease.tenantId) ?? lease.tenantId}
      emptyMessage="ยังไม่มีสัญญาเช่าสำหรับห้องนี้"
    />
  </DetailSheet>

  <p class="mt-4 mb-2 leading-none">
    <a
      href={consolePath(`console/rooms/${room.id}/edit`)}
      class="text-sm text-console-ink underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
      >แก้ไขข้อมูลห้อง</a
    >
  </p>

  <p class="mt-0 mb-0 leading-none text-console-ink-soft">
    <a
      href={consolePath('console/rooms')}
      class="text-sm underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-console-rule"
      >← กลับไปรายการห้อง</a
    >
  </p>
</ConsoleFrame>
