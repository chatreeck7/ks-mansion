---
// src/pages/console/index.astro
// `astro check` reports `consolePath` as unused here (ts 6133). It is a false
// positive — TypeScript's analysis stops at the top-level `return`. Verified
// at runtime: this serves a 302 to /console/rooms. Do not "fix" it by moving
// the call into the template as `{Astro.redirect(...)}` — that renders the
// Response into the body and serves a 200 instead of redirecting.
import { consolePath } from '@/lib/console/paths';

return Astro.redirect(consolePath('console/rooms'), 302);
---
